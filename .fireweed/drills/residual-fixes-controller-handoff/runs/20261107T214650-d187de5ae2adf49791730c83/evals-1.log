		assertAbsent(t, root)
	})

	t.Run("empty valid queue", func(t *testing.T) {
		root := fixture(t, "", "", "", "", "")
		if err := os.Remove(filepath.Join(root, "changes/0001-manual.md")); err != nil {
			t.Fatal(err)
		}
		assertAbsent(t, root)
	})

	t.Run("claim owned by another worktree", func(t *testing.T) {
