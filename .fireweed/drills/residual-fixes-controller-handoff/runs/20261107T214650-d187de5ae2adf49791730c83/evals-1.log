package lifecycle

import (
	"context"
	"errors"
	"fmt"
	"strings"
	"time"

	"github.com/lurkshark/fireweed/packages/contracts"
	"github.com/lurkshark/fireweed/packages/gitstore"
	"github.com/lurkshark/fireweed/packages/workflow/model"
)

func blockGit(root string, input []byte, args ...string) (string, error) {
	argv := append([]string{"git", "-C", root, "-c", "core.hooksPath=/dev/null"}, args...)
	result, err := gitstore.Run(context.Background(), gitstore.Request{
		Args: argv, Input: input, Timeout: 30 * time.Second,
		Env: map[string]string{"GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0"},
	})
	if err != nil {
		return "", fmt.Errorf("git %s: %w: %s", strings.Join(args, " "), err, result.Stderr)
	}
	return strings.TrimSpace(result.Stdout), nil
}

// The phase base is the last committed approval. Start's assigned IDs, run,
// and phase are held in the claim until the next phase commit.
func blockDocument(root string, s model.State, c claim) (contracts.Document, error) {
	base, err := gitstore.ReadAt(root, c.PhaseBase, s.Change.Path)
	if err != nil {
		return contracts.Document{}, err
	}
	content := string(base)
	baseDoc, err := contracts.ParseDocument(content)
	if err != nil {
		return contracts.Document{}, err
	}
	oldAdded, _ := contracts.Section(baseDoc.Body, "Added")
	newAdded := c.Sections["Added"]
	oldItems, oldErr := contracts.ParseItems(oldAdded)
	newItems, newErr := contracts.ParseItems(newAdded)
	if oldErr == nil && newErr == nil && len(oldItems) == len(newItems) {
		assigned := map[string]string{}
		for i, item := range oldItems {
			if strings.HasPrefix(item.ID, "new:") {
				assigned[item.ID] = newItems[i].ID
			}
		}
		content = handle.ReplaceAllStringFunc(content, func(id string) string {
			if replacement := assigned[id]; replacement != "" {
				return replacement
			}
			return id
		})
	}
	doc, err := contracts.ParseDocument(content)
	if err != nil {
		return contracts.Document{}, err
	}
	for _, name := range authorNames {
		if current, exists := contracts.Section(doc.Body, name); exists && current != c.Sections[name] {
			doc.Body = contracts.ReplaceSection(doc.Body, name, c.Sections[name])
		}
	}
	doc.Frontmatter = cloneMap(c.Author)
	for key, value := range c.Audit {
		doc.Frontmatter[key] = value
	}
	doc.Frontmatter["run"] = c.Run
	doc.Frontmatter["phase"] = c.Phase
	return doc, nil
}

func nextAttempt(root, slug, oid string) (string, error) {
	for n := 1; ; n++ {
		name := fmt.Sprintf("refs/fireweed/attempts/%s/%d", slug, n)
		_, exists, err := gitstore.Ref(root, name)
		if err != nil {
			return "", err
		}
		if exists {
			continue
		}
		if err := gitstore.CASRef(root, name, "", oid); err != nil {
			// A second worktree may have taken this number since the lookup.
			if _, taken, lookupErr := gitstore.Ref(root, name); lookupErr == nil && taken {
				continue
			}
			return "", err
		}
		return name, nil
	}
}

func Block(request model.BlockRequest) (model.BlockResult, error) {
	var result model.BlockResult
	s, c, err := loadCurrent(request.Root, request.Change)
	result.State = s
	if err != nil {
		return result, err
	}
	if err := validate(s, c); err != nil {
		return result, err
	}
	if s.Head != c.PhaseBase {
		return result, errors.New("P05: HEAD differs from the held phase base")
	}
	if strings.TrimSpace(request.Reason) == "" {
		return result, errors.New("blocked reason is empty")
	}
	switch c.Phase {
	case "evals", "audit", "impl":
	default:
		return result, fmt.Errorf("P01: unsupported phase %s", c.Phase)
	}
	root := s.Snapshot.Root
	doc, err := blockDocument(root, s, c)
	if err != nil {
		return result, err
	}
	if _, err = blockGit(root, nil, "add", "-A"); err != nil {
		return result, err
	}
	tree, err := blockGit(root, nil, "write-tree")
	if err != nil {
		return result, err
	}
	attemptOID, err := blockGit(root, []byte("attempt: "+s.Change.Slug+"\n"), "commit-tree", tree, "-p", c.PhaseBase)
	if err != nil {
		return result, err
	}
	attemptRef, err := nextAttempt(root, s.Change.Slug, attemptOID)
	if err != nil {
		return result, err
	}
	result.AttemptRef, result.AttemptOID = attemptRef, attemptOID
	if _, err = blockGit(root, nil, "reset", "--hard", c.PhaseBase); err != nil {
		return result, err
	}
	if _, err = blockGit(root, nil, "clean", "-fd"); err != nil {
		return result, err
	}
	doc.Frontmatter["blocked"] = request.Reason
	rendered, err := contracts.RenderDocument(doc)
	if err != nil {
		return result, err
	}
	if err = write(root, s.Change.Path, []byte(rendered)); err != nil {
		return result, err
	}
	head, err := gitstore.Commit(root, "chore("+s.Change.Module+"): block "+s.Change.Slug, []string{s.Change.Path})
	if err != nil {
		return result, err
	}
	if err = gitstore.CASRef(root, ref(s.Change.Slug), s.ClaimOID, ""); err != nil {
		return result, err
	}
	c.PhaseBase = head
	s.Change.Document = doc
	result.State = state(root, s.Change, c, "", head)
	return result, nil
}

- packages/workflow/internal/lifecycle/commits_stub.go (4170 bytes)
package lifecycle

import (
	"context"
	"fmt"
	"path"
	"regexp"
	"strings"
	"time"

	"github.com/lurkshark/fireweed/packages/contracts"
	"github.com/lurkshark/fireweed/packages/gitstore"
)

var commitChangeName = regexp.MustCompile(`^[0-9]{4,}-[a-z0-9-]+\.md$`)

func commitsGit(root string, args ...string) (string, error) {
	result, err := gitstore.Run(context.Background(), gitstore.Request{
		Args:    append([]string{"git", "-C", root, "-c", "core.hooksPath=/dev/null"}, args...),
		Timeout: 30 * time.Second,
		Env: map[string]string{
			"GIT_NO_LAZY_FETCH": "1", "GIT_TERMINAL_PROMPT": "0", "GIT_OPTIONAL_LOCKS": "0",
		},
	})
	if err != nil {
		return "", fmt.Errorf("git %s: %w: %s", strings.Join(args, " "), err, result.Stderr)
	}
	return result.Stdout, nil
}

func commitChangePaths(root, revision string) ([]string, error) {
	out, err := commitsGit(root, "ls-tree", "-r", "--name-only", "-z", revision, "--", "changes")
	if err != nil {
		return nil, err
	}
	var paths []string
	for _, candidate := range strings.Split(out, "\x00") {
		if candidate == "" {
			continue
		}
		dir := path.Dir(candidate)
		if (dir == "changes" || dir == "changes/archive") && commitChangeName.MatchString(path.Base(candidate)) {
			paths = append(paths, candidate)
		}
	}
	return paths, nil
}

func selectCommitChange(paths []string, selector string) (string, error) {
	var matches []string
	slugs := make([]string, 0, len(paths))
	for _, candidate := range paths {
		base := path.Base(candidate)
		slug := strings.TrimSuffix(base[strings.IndexByte(base, '-')+1:], ".md")
		slugs = append(slugs, slug)
		if selector == candidate {
			return base, nil
		}
		if selector == base || selector == slug {
			matches = append(matches, base)
		}
	}
	if len(matches) == 1 {
		return matches[0], nil
	}
	if len(matches) == 0 {
		return "", unknownChange(selector, slugs)
	}
	return "", fmt.Errorf("U02: change %q is ambiguous", selector)
}

func commitPhaseAt(root, revision, basename string) (string, error) {
	if revision == "" {
		return "", nil
	}
	pending := "changes/" + basename
	archived := "changes/archive/" + basename
	out, err := commitsGit(root, "ls-tree", "-r", "--name-only", "-z", revision, "--", pending, archived)
	if err != nil {
		return "", err
	}
	var found string
	for _, candidate := range strings.Split(out, "\x00") {
		if candidate != pending && candidate != archived {
			continue
		}
		if found != "" {
			return "", fmt.Errorf("change %s has pending and archived copies at %s", basename, revision)
		}
		found = candidate
	}
	if found == "" {
		return "", nil
	}
	data, err := gitstore.ReadAt(root, revision, found)
	if err != nil {
		return "", fmt.Errorf("read %s at %s: %w", found, revision, err)
	}
	doc, err := contracts.ParseDocument(string(data))
	if err != nil {
		return "", fmt.Errorf("parse %s at %s: %w", found, revision, err)
	}
	phase, _ := doc.Frontmatter["phase"].(string)
	return phase, nil
}

// Commits returns reachable commits that changed this document's phase.
func Commits(root, change string) ([]string, error) {
	repo, err := gitstore.Inspect(root)
	if err != nil {
		return nil, err
	}
	root = repo.Root
	paths, err := commitChangePaths(root, repo.Head)
	if err != nil {
		return nil, err
	}
	basename, err := selectCommitChange(paths, change)
	if err != nil {
		return nil, err
	}
	out, err := commitsGit(root, "rev-list", "--topo-order", "--parents", repo.Head)
	if err != nil {
		return nil, err
	}
	cache := map[string]string{}
	phaseAt := func(oid string) (string, error) {
		if phase, ok := cache[oid]; ok {
			return phase, nil
		}
		phase, err := commitPhaseAt(root, oid, basename)
		if err == nil {
			cache[oid] = phase
		}
		return phase, err
	}
	var commits []string
	for _, line := range strings.Split(strings.TrimSpace(out), "\n") {
		fields := strings.Fields(line)
		if len(fields) == 0 {
			continue
		}
		phase, err := phaseAt(fields[0])
		if err != nil {
			return nil, err
		}
		parent := ""
		if len(fields) > 1 {
			parent = fields[1]
		}
		previous, err := phaseAt(parent)
		if err != nil {
			return nil, err
		}
		if phase != previous {
			commits = append(commits, fields[0])
		}
	}
	return commits, nil
}

