func Test_RUN_067_PromptFileLifetimeOnExitTimeoutCancellationAndLaunchFailure(t *testing.T) {
	for _, tc := range []struct{ name string }{
		{"success"}, {"nonzero"}, {"timeout"}, {"cancellation"}, {"launch failure"},
	} {
