case "$module" in alpha) prefix=ALP;; beta) prefix=BET;; gamma) prefix=GAM;; *) exit 31;; esac
printf '%s|%s|%s|%s\n' "$module" "$phase" "$PWD" "$FIREWEED_BIN" >> "$1/invocations"
