printf '%s' "$3" > "$1/path"
printf '%s' "$4" > "$1/common"
printf '%s' "$5" > "$1/second-path"
cat "$3" > "$1/content" || exit 12
shift 5
exec "$@"`)
	snap.Config["agent"] = map[string]any{
