# Eval: packages/runner/evals/retry_failure_details_test.go
package evals_test

import (
	"fmt"
	"strings"
	"testing"
	"unicode/utf8"

	"github.com/lurkshark/fireweed/packages/project"
)

// The hook puts assertions only in JUnit. Its last stderr line also separates
// the existing verification feedback from the new failed-case detail section.
const retryDetailHookMarker = "HOOK_ALPHA_STDERR_ONLY"

func retryDetailFixture(t *testing.T, alphaFailed, dependentFailed string) nextFixture {
	t.Helper()
	f := newNextFixture(t, true, true, "retry-impl")
	nextWrite(t, f.root, "packages/aardvark/SPEC.md", "---\nname: aardvark\nid_prefix: AAR\ndepends_on: [alpha]\n---\n# Aardvark\n\n## Specs\n\n### AAR-001\nAardvark MUST return a value.\n\n## Decisions\n")
	nextWrite(t, f.root, "packages/aardvark/api.go", "package aardvark\nfunc Value() string { return \"old\" }\n")
	nextWrite(t, f.root, "packages/aardvark/evals/existing_test.go", "package evals\nimport (\"testing\"; \"example.invalid/next-fixture/packages/aardvark\")\nfunc Test_AAR_001_Value(t *testing.T) { if aardvark.Value() == \"\" { t.Fatal(\"empty\") } }\n")
	// The first evals report supplies fail-first evidence. The first impl agent
	// writes "wrong"; the retry writes "new" and both reports then pass.
	hook := fmt.Sprintf(`#!/bin/sh
phase=$(sed -n 's/^phase: //p' changes/0001-next.md | head -1)
if [ "$phase" = evals ]; then
  cat > "$2" <<'XML'
<testsuite><testcase name="ALP-001" classname="base"/><testcase name="ALP-002_eval" classname="added"><failure message="eval fails before implementation"/></testcase></testsuite>
XML
  exit 1
fi
if grep -q 'return "wrong"' packages/alpha/internal/value.go; then
  if [ "$1" = alpha ]; then
    cat > "$2" <<'XML'
%s
XML
    printf '%%s\n' '%s' >&2
  else
    cat > "$2" <<'XML'
%s
XML
  fi
  exit 1
fi
if [ "$1" = alpha ]; then
  printf '%%s' '<testsuite><testcase name="ALP-001"/><testcase name="ALP-002"/></testsuite>' > "$2"
else
  printf '%%s' '<testsuite><testcase name="AAR-001"/></testsuite>' > "$2"
fi
`, alphaFailed, retryDetailHookMarker, dependentFailed)
	nextWrite(t, f.root, ".fireweed/eval.sh", hook)
	nextCommit(t, f.root, "fixture with dependent JUnit failures")
	for _, d := range project.Check(f.root) {
		if !d.Warning {
			t.Fatalf("invalid retry-detail fixture: %#v", d)
		}
	}
	return f
}

func retryDetailSection(t *testing.T, f nextFixture) (string, string) {
	t.Helper()
	first := nextRead(t, f.logDir, "worker-impl-1.prompt")
	retry := nextRead(t, f.logDir, "worker-impl-2.prompt")
	if !strings.HasPrefix(retry, first) {
		t.Fatal("retry did not retain the original worker context")
	}
	const marker = retryDetailHookMarker + "\n"
	i := strings.LastIndex(retry, marker)
	if i < len(first) {
		t.Fatalf("retry prompt lost dependent hook stderr marker: %q", retry[len(first):])
	}
	return retry[len(first):], retry[i+len(marker):]
}

func Test_RUN_043_RetryIncludesJUnitOnlyCasesFromOwnAndDependentModules(t *testing.T) {
	alpha := `<testsuite>
<testcase name="ALP-001_pass_only" classname="pass.class"/>
<testcase name="ALP-002_first" classname="alpha.first"><failure message="RUN043_ALPHA_FIRST_ASSERTION"/></testcase>
<testcase name="ALP-002_skip_only" classname="skip.class"><skipped/></testcase>
<testcase name="ALP-002_second" classname="alpha.second"><error>RUN043_ALPHA_SECOND_ASSERTION</error></testcase>
</testsuite>`
	dependent := `<testsuite>
<testcase name="AAR-001_dependent" classname="aardvark.dependent"><failure message="RUN043_DEPENDENT_ASSERTION"/></testcase>
<testcase name="AAR-001_pass_only" classname="aardvark.pass"/>
</testsuite>`
	f := retryDetailFixture(t, alpha, dependent)
	r, err := f.run(false)
	if err != nil || r.State.Phase != "applied" || len(r.Steps) != 4 {
		t.Fatalf("Next with JUnit-only dependent failure = %#v, %v", r, err)
	}
	feedback, section := retryDetailSection(t, f)
	if !strings.Contains(feedback, "E01: failed case") || !strings.Contains(feedback, retryDetailHookMarker) {
		t.Error("retry lost existing verification feedback or hook stderr")
	}
	for _, want := range []string{
		"aardvark", "AAR-001_dependent", "aardvark.dependent", "RUN043_DEPENDENT_ASSERTION",
		"alpha", "ALP-002_first", "alpha.first", "RUN043_ALPHA_FIRST_ASSERTION",
		"ALP-002_second", "alpha.second", "RUN043_ALPHA_SECOND_ASSERTION",
	} {
		if !strings.Contains(section, want) {
			t.Errorf("failed-case section lacks %q: %q", want, section)
		}
	}
	for _, absent := range []string{"ALP-001_pass_only", "ALP-002_skip_only", "AAR-001_pass_only"} {
		if strings.Contains(section, absent) {
			t.Errorf("nonfailed case %q included in detail section", absent)
		}
	}
	previous := -1
	for _, name := range []string{"AAR-001_dependent", "ALP-002_first", "ALP-002_second"} {
		i := strings.Index(section, name)
		if i <= previous {
			t.Errorf("failed cases are not in module and report order: %q", section)
			break
		}
		previous = i
	}
}

func Test_RUN_044_RetryBoundsUnicodeFailureExcerptsAndMarksOmissions(t *testing.T) {
	var alpha strings.Builder
	alpha.WriteString(`<testsuite><testcase name="ALP-001"/>`)
	for i := 0; i < 12; i++ {
		fill := strings.Repeat("界", 5000)
		fmt.Fprintf(&alpha, `<testcase name="ALP-002_long_%02d" classname="large.case"><failure>RUN044_HEAD_%02d_%s_RUN044_TAIL_%02d</failure></testcase>`, i, i, fill, i)
	}
	alpha.WriteString(`</testsuite>`)
	dependent := `<testsuite><testcase name="AAR-001_first" classname="first.case"><failure>RUN044_DEPENDENT_FIRST</failure></testcase></testsuite>`
	f := retryDetailFixture(t, alpha.String(), dependent)
	r, err := f.run(false)
	if err != nil || r.State.Phase != "applied" || len(r.Steps) != 4 {
		t.Fatalf("Next with large JUnit failures = %#v, %v", r, err)
	}
	_, section := retryDetailSection(t, f)
	if n := utf8.RuneCountInString(section); n > 16384 {
		t.Errorf("failed-case section has %d Unicode code points, want at most 16384", n)
	}
	if !strings.Contains(section, "RUN044_HEAD_00_") || !strings.Contains(section, strings.Repeat("界", 4000)) {
		t.Error("first failure did not receive a readable Unicode excerpt")
	}
	for i := 0; i < 12; i++ {
		head := fmt.Sprintf("RUN044_HEAD_%02d_", i)
		start := strings.Index(section, head)
		if start < 0 {
			continue // This case was omitted under the section budget.
		}
		fillRunes := 0
		for _, r := range section[start+len(head):] {
			if r != '界' {
				break
			}
			fillRunes++
		}
		if n := utf8.RuneCountInString(head) + fillRunes; n > 4096 {
			t.Errorf("case %d failure excerpt contains at least %d Unicode code points, want at most 4096", i, n)
		}
		if strings.Contains(section, fmt.Sprintf("RUN044_TAIL_%02d", i)) {
			t.Errorf("case %d failure excerpt continued past its first 4096 code points", i)
		}
	}
	if !strings.Contains(section, "RUN044_DEPENDENT_FIRST") || strings.Index(section, "RUN044_DEPENDENT_FIRST") >= strings.Index(section, "RUN044_HEAD_00_") {
		t.Error("lexically first dependent failure was omitted or misordered")
	}
	if strings.Contains(section, "ALP-002_long_11") {
		t.Error("section exceeded its budget instead of omitting later cases")
	}
	lower := strings.ToLower(section)
	if !strings.Contains(lower, "truncat") && !strings.Contains(lower, "shorten") && !strings.Contains(section, "…") {
		t.Error("shortened diagnostic text has no marker")
	}
	if !strings.Contains(lower, "omitt") && !strings.Contains(lower, "remaining") && !strings.Contains(lower, "more cases") && !strings.Contains(lower, "additional cases") {
		t.Error("omitted cases have no marker")
	}
}


# Eval: packages/runner/evals/run_test.go
package evals_test

import (
	"context"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"testing"
	"time"

	"github.com/lurkshark/fireweed/packages/checks"
	"github.com/lurkshark/fireweed/packages/project"
	"github.com/lurkshark/fireweed/packages/runner"
	"github.com/lurkshark/fireweed/packages/workflow"
)

type runFixture struct{ root, agents string }

var runModules = []struct{ name, prefix string }{{"alpha", "ALP"}, {"beta", "BET"}, {"gamma", "GAM"}}

func newRunFixture(t *testing.T, queued int, unmerged, failBeta bool) runFixture {
	t.Helper()
	mode := "normal"
	if failBeta {
		mode = "fail-beta"
	}
	return newRunFixtureMode(t, queued, unmerged, mode)
}

func newRunFixtureMode(t *testing.T, queued int, unmerged bool, mode string) runFixture {
	t.Helper()
	root, err := filepath.EvalSymlinks(t.TempDir())
	if err != nil {
		t.Fatal(err)
	}
	agents, err := filepath.EvalSymlinks(t.TempDir())
	if err != nil {
		t.Fatal(err)
	}
	nextWrite(t, agents, "worker.sh", `#!/bin/bash
held=''
for file in changes/*.md; do
  [ -f "$file" ] || continue
  [ -z "$(sed -n 's/^blocked: //p' "$file" | head -1)" ] || continue
  case "$(sed -n 's/^phase: //p' "$file" | head -1)" in evals|impl) held="$file"; break;; esac
done
[ -n "$held" ] || { echo 'no held change' >&2; exit 30; }
phase=$(sed -n 's/^phase: //p' "$held" | head -1)
module=$(sed -n 's/^module: //p' "$held" | head -1)
case "$module" in alpha) prefix=ALP;; beta) prefix=BET;; gamma) prefix=GAM;; *) exit 31;; esac
printf '%s|%s|%s|%s\n' "$module" "$phase" "$PWD" "$FIREWEED_BIN" >> "$1/invocations"
if [ "$2" = fail-beta ] && [ "$module" = beta ] && [ "$phase" = evals ]; then echo 'held beta failure' >&2; exit 17; fi
if [ "$2" = exhaust-alpha ] && [ "$module" = alpha ] && [ "$phase" = evals ]; then printf 'alpha-no-edit'; exit 0; fi
sleep 0.12
case "$phase" in
  evals)
    cat > "packages/$module/evals/added_test.go" <<GO
package evals
import (
  "testing"
  "example.invalid/run-fixture/packages/$module"
)
func Test_${prefix}_002_Added(t *testing.T) {
  if $module.Value() != "new" { t.Fatalf("${prefix}-002: got %q", $module.Value()) }
}
GO
    ;;
  impl)
    cat > "packages/$module/internal/value.go" <<'GO'
package internal
func Value() string { return "new" }
GO
    ;;
  *) exit 32;;
esac
printf '%s-%s' "$module" "$phase"
`)
	nextWrite(t, agents, "auditor.sh", `#!/bin/bash
held=''
for file in changes/*.md; do
  [ -f "$file" ] || continue
  [ -z "$(sed -n 's/^blocked: //p' "$file" | head -1)" ] || continue
  if [ "$(sed -n 's/^phase: //p' "$file" | head -1)" = audit ]; then held="$file"; break; fi
done
[ -n "$held" ] || { echo 'no held audit' >&2; exit 33; }
module=$(sed -n 's/^module: //p' "$held" | head -1)
case "$module" in alpha) prefix=ALP;; beta) prefix=BET;; gamma) prefix=GAM;; *) exit 34;; esac
printf '%s|audit|%s|%s\n' "$module" "$PWD" "$FIREWEED_BIN" >> "$1/invocations"
sleep 0.12
printf '\n## Audit\nNo findings\nChecked IDs: %s-002\n' "$prefix" >> "$held"
printf '%s-audit' "$module"
`)
	nextWrite(t, root, ".gitignore", ".fireweed/runs/\n.fireweed/go-test.log\n")
	nextWrite(t, root, "go.mod", "module example.invalid/run-fixture\n\ngo 1.22\n")
	nextWrite(t, root, "SYSTEM.md", "# Fixture\n")
	nextWrite(t, root, "fireweed.yaml", fmt.Sprintf(`fireweed: ">=0.1, <0.2"
version: 1
base: main
modules: ["packages/*"]
module_defaults:
  interface: [api.go]
  evals: [evals/**]
  disposable: [internal/**]
hooks:
  eval: [sh, .fireweed/eval.sh, "{module}", "{report}"]
  boundaries: [sh, .fireweed/boundaries.sh]
agent:
  command: [bash, %q, %q, %q, "{prompt}"]
audit:
  command: [bash, %q, %q, "{prompt}"]
timeout: 50ms
`, filepath.Join(agents, "worker.sh"), agents, mode, filepath.Join(agents, "auditor.sh"), agents))
	nextWrite(t, root, ".fireweed/eval.sh", `#!/bin/sh
case "$1" in alpha) prefix=ALP;; beta) prefix=BET;; gamma) prefix=GAM;; *) exit 35;; esac
go test "./packages/$1/evals" > .fireweed/go-test.log 2>&1
code=$?
if [ "$code" -eq 0 ]; then result=''; else result='<failure message="Go eval failed"/>'; fi
printf '<testsuite><testcase name="%s-001" classname="fixture"/><testcase name="%s-002" classname="fixture">%s</testcase></testsuite>' "$prefix" "$prefix" "$result" > "$2"
exit "$code"
`)
	nextWrite(t, root, ".fireweed/boundaries.sh", "#!/bin/sh\nexit 0\n")
	for _, m := range runModules {
		nextWrite(t, root, "packages/"+m.name+"/SPEC.md", fmt.Sprintf("---\nname: %s\nid_prefix: %s\ndepends_on: []\n---\n# %s\n\n## Specs\n\n### %s-001\n%s MUST return a value.\n\n## Decisions\n", m.name, m.prefix, m.name, m.prefix, m.name))
		nextWrite(t, root, "packages/"+m.name+"/api.go", fmt.Sprintf("package %s\nimport \"example.invalid/run-fixture/packages/%s/internal\"\nfunc Value() string { return internal.Value() }\n", m.name, m.name))
		nextWrite(t, root, "packages/"+m.name+"/internal/value.go", "package internal\nfunc Value() string { return \"old\" }\n")
		nextWrite(t, root, "packages/"+m.name+"/evals/existing_test.go", fmt.Sprintf("package evals\nimport (\"testing\"; \"example.invalid/run-fixture/packages/%s\")\nfunc Test_%s_001_Value(t *testing.T) { if %s.Value() == \"\" { t.Fatal(\"empty\") } }\n", m.name, m.prefix, m.name))
	}
	nextGit(t, root, "init", "-q")
	nextGit(t, root, "checkout", "-q", "-b", "main")
	nextGit(t, root, "config", "user.name", "Fixture")
	nextGit(t, root, "config", "user.email", "fixture@example.invalid")
	if unmerged {
		nextCommit(t, root, "base fixture")
		nextGit(t, root, "checkout", "-q", "-b", "feature")
	}
	for _, m := range runModules[:queued] {
		change := fmt.Sprintf("---\nmodule: %s\nbases: {}\n---\n\n## Motivation\nNew value needed.\n\n## Interface\nExisting Value function.\n\n## Added\n\n### new:value\n%s MUST return the new value.\n\n## Modified\n\n## Removed\n\n## Decisions\n", m.name, m.name)
		nextWrite(t, root, fmt.Sprintf("changes/%04d-%s.md", indexRunModule(m.name)+1, m.name), change)
	}
	nextCommit(t, root, "queued fixture")
	for _, d := range project.Check(root) {
		if !d.Warning {
			t.Fatalf("bad fixture: %#v", d)
		}
	}
	return runFixture{root, agents}
}

func indexRunModule(name string) int {
	for i, m := range runModules {
		if m.name == name {
			return i
		}
	}
	return -1
}

func (f runFixture) request(max int, allow bool) runner.RunRequest {
	return runner.RunRequest{Root: f.root, Bin: "/fixture/run-bin", AllowUnmerged: allow, Timeout: 20 * time.Second, Max: max}
}

func runArchive(t *testing.T, f runFixture, i int) string {
	t.Helper()
	return nextRead(t, f.root, fmt.Sprintf("changes/archive/%04d-%s.md", i+1, runModules[i].name))
}

func runInvocations(t *testing.T, f runFixture) []string {
	t.Helper()
	b, err := os.ReadFile(filepath.Join(f.agents, "invocations"))
	if os.IsNotExist(err) {
		return nil
	}
	if err != nil {
		t.Fatal(err)
	}
	return strings.Split(strings.TrimSpace(string(b)), "\n")
}

func assertRunApplied(t *testing.T, f runFixture, applied []runner.NextResult, want ...string) {
	assertRunAppliedSteps(t, f, applied, 3, want...)
}

func assertRunAppliedSteps(t *testing.T, f runFixture, applied []runner.NextResult, stepCount int, want ...string) {
	t.Helper()
	if len(applied) != len(want) {
		t.Fatalf("Applied count = %d, want %d: %#v", len(applied), len(want), applied)
	}
	for i, name := range want {
		r := applied[i]
		if r.Empty || r.State.Phase != "applied" || r.State.Change.Slug != name || r.State.Snapshot.Root != f.root || r.State.Run == "" || len(r.Steps) != stepCount {
			t.Errorf("Applied[%d] = %#v", i, r)
		}
		archive := runArchive(t, f, indexRunModule(name))
		if !strings.Contains(archive, "phase: applied") || !strings.Contains(archive, "No findings; checked "+runModules[indexRunModule(name)].prefix+"-002") {
			t.Errorf("%s archive = %q", name, archive)
		}
		id := runModules[indexRunModule(name)].prefix + "-002"
		for _, phase := range []struct{ name, result string }{{"evals", "fail"}, {"impl", "pass"}} {
			path := filepath.Join(f.root, ".fireweed", "runs", r.State.Run, phase.name, name+".json")
			data, err := os.ReadFile(path)
			if err != nil {
				t.Fatal(err)
			}
			var report checks.Report
			if err := json.Unmarshal(data, &report); err != nil {
				t.Fatal(err)
			}
			found := false
			for _, c := range report.Cases {
				if c.Result == phase.result {
					for _, got := range c.IDs {
						if got == id {
							found = true
						}
					}
				}
			}
			if !found {
				t.Errorf("%s %s report lacks %s %s: %#v", name, phase.name, id, phase.result, report)
			}
		}
	}
}

func assertRunAgentLog(t *testing.T, f runFixture, want ...string) {
	t.Helper()
	got := runInvocations(t, f)
	if len(got) != len(want)*3 {
		t.Fatalf("agent calls = %#v, want %d changes", got, len(want))
	}
	for i, name := range want {
		for j, phase := range []string{"evals", "audit", "impl"} {
			parts := strings.Split(got[i*3+j], "|")
			if len(parts) != 4 || parts[0] != name || parts[1] != phase || parts[3] != "/fixture/run-bin" {
				t.Errorf("agent call %d = %q", i*3+j, got[i*3+j])
				continue
			}
			if phase == "audit" {
				if parts[2] == f.root || !filepath.IsAbs(parts[2]) {
					t.Errorf("audit call %d used held checkout: %q", i*3+j, got[i*3+j])
				} else if _, err := os.Stat(parts[2]); !os.IsNotExist(err) {
					t.Errorf("audit workspace %q remains: %v", parts[2], err)
				}
			} else if parts[2] != f.root {
				t.Errorf("worker call %d left held checkout: %q", i*3+j, got[i*3+j])
			}
		}
	}
}

func runBlockedDependencyFixture(t *testing.T) runFixture {
	t.Helper()
	f := newRunFixtureMode(t, 3, false, "exhaust-alpha")
	spec := nextRead(t, f.root, "packages/beta/SPEC.md")
	nextWrite(t, f.root, "packages/beta/SPEC.md", strings.Replace(spec, "depends_on: []", "depends_on: [alpha]", 1))
	nextCommit(t, f.root, "beta depends on alpha")
	for _, d := range project.Check(f.root) {
		if !d.Warning {
			t.Fatalf("invalid dependent queue: %#v", d)
		}
	}
	return f
}

func assertRunBlockedAlpha(t *testing.T, f runFixture, err error) {
	t.Helper()
	const cause = "P2-01: no fail-first case for ALP-002"
	const ref = "refs/fireweed/attempts/alpha/1"
	if err == nil || !strings.Contains(err.Error(), cause) || !strings.Contains(err.Error(), ref) {
		t.Errorf("Run blocking error = %v, want verification cause and %s", err, ref)
	}
	if saved := nextGit(t, f.root, "for-each-ref", "--format=%(objectname)", ref); saved == "" {
		t.Errorf("missing saved attempt %s", ref)
	} else if kind := nextGit(t, f.root, "cat-file", "-t", saved); kind != "commit" {
		t.Errorf("attempt ref holds %q", kind)
	}
	if blocked := nextRead(t, f.root, "changes/0001-alpha.md"); !strings.Contains(blocked, "blocked:") || !strings.Contains(blocked, "phase: evals") || !strings.Contains(blocked, "### ALP-002") {
		t.Errorf("alpha block state = %q", blocked)
	}
	if claim := nextGit(t, f.root, "for-each-ref", "--format=%(refname)", "refs/fireweed/claims"); claim != "" {
		t.Errorf("blocked run retained claim %q", claim)
	}
	if status := nextGit(t, f.root, "status", "--porcelain", "-uall"); status != "" {
		t.Errorf("blocked run left dirty checkout %q", status)
	}
}

func assertRunBetaWaiting(t *testing.T, f runFixture) {
	t.Helper()
	beta := nextRead(t, f.root, "changes/0002-beta.md")
	if strings.Contains(beta, "run:") || strings.Contains(beta, "phase:") || strings.Contains(beta, "blocked:") {
		t.Errorf("dependent beta was started: %q", beta)
	}
	if _, err := os.Stat(filepath.Join(f.root, "changes/archive/0002-beta.md")); !os.IsNotExist(err) {
		t.Errorf("dependent beta archived: %v", err)
	}
}

func Test_RUN_016_UnlimitedQueueOrder(t *testing.T) {
	f := newRunFixture(t, 3, false, false)
	r, err := runner.Run(context.Background(), f.request(0, false))
	if err != nil {
		t.Fatalf("Run: %#v, %v", r, err)
	}
	if !r.Empty || r.Limited {
		t.Errorf("flags = Empty %v Limited %v", r.Empty, r.Limited)
	}
	assertRunApplied(t, f, r.Applied, "alpha", "beta", "gamma")
	assertRunAgentLog(t, f, "alpha", "beta", "gamma")
	if q, err := project.Queue(f.root); err != nil || len(q) != 0 {
		t.Errorf("remaining queue = %#v, %v", q, err)
	}
}

func Test_RUN_016_NegativeMaxIsUnlimited(t *testing.T) {
	f := newRunFixture(t, 1, false, false)
	r, err := runner.Run(context.Background(), f.request(-1, false))
	if err != nil {
		t.Fatalf("Run: %#v, %v", r, err)
	}
	if !r.Empty || r.Limited {
		t.Errorf("flags = %#v", r)
	}
	assertRunApplied(t, f, r.Applied, "alpha")
}

func Test_RUN_017_RUN_018_RUN_019_BoundedContinuationAndForwarding(t *testing.T) {
	f := newRunFixture(t, 3, true, false)
	first, err := runner.Run(context.Background(), f.request(1, true))
	if err != nil {
		t.Fatalf("first Run: %#v, %v", first, err)
	}
	if first.Empty || !first.Limited {
		t.Errorf("first flags = %#v", first)
	}
	assertRunApplied(t, f, first.Applied, "alpha")
	firstArchive := runArchive(t, f, 0)
	q, err := project.Queue(f.root)
	if err != nil || len(q) != 2 || q[0].Slug != "beta" || q[1].Slug != "gamma" {
		t.Errorf("remaining queue = %#v, %v", q, err)
	}
	second, err := runner.Run(context.Background(), f.request(0, true))
	if err != nil {
		t.Fatalf("continuation: %#v, %v", second, err)
	}
	if !second.Empty || second.Limited {
		t.Errorf("continuation flags = %#v", second)
	}
	assertRunApplied(t, f, second.Applied, "beta", "gamma")
	assertRunAgentLog(t, f, "alpha", "beta", "gamma")
	if archive := runArchive(t, f, 0); archive != firstArchive {
		t.Error("first archive changed during continuation")
	}
	if q, err := project.Queue(f.root); err != nil || len(q) != 0 {
		t.Errorf("remaining queue = %#v, %v", q, err)
	}
}

func Test_RUN_018_InitialEmptyAndExactLimit(t *testing.T) {
	t.Run("initial_empty", func(t *testing.T) {
		f := newRunFixture(t, 0, false, false)
		before := nextGit(t, f.root, "rev-parse", "HEAD")
		r, err := runner.Run(context.Background(), f.request(2, false))
		if err != nil || !r.Empty || r.Limited || len(r.Applied) != 0 {
			t.Errorf("empty Run = %#v, %v", r, err)
		}
		if nextGit(t, f.root, "rev-parse", "HEAD") != before || len(runInvocations(t, f)) != 0 {
			t.Error("empty Run changed repo or invoked agents")
		}
	})
	t.Run("exact_limit", func(t *testing.T) {
		f := newRunFixture(t, 2, false, false)
		r, err := runner.Run(context.Background(), f.request(2, false))
		if err != nil {
			t.Fatalf("exact Run: %#v, %v", r, err)
		}
		if !r.Empty || r.Limited {
			t.Errorf("exact flags = %#v", r)
		}
		assertRunApplied(t, f, r.Applied, "alpha", "beta")
		assertRunAgentLog(t, f, "alpha", "beta")
	})
}

func Test_RUN_020_HeldFailureRetainsEarlierResults(t *testing.T) {
	f := newRunFixture(t, 3, false, true)
	r, err := runner.Run(context.Background(), f.request(0, false))
	if err == nil || !strings.Contains(err.Error(), "17") {
		t.Errorf("held failure cause = %v", err)
	}
	assertRunApplied(t, f, r.Applied, "alpha")
	state, currentErr := workflow.Current(f.root, "beta")
	if currentErr != nil || state.Phase != "evals" || state.Run == "" {
		t.Errorf("held beta = %#v, %v", state, currentErr)
	}
	if _, statErr := os.Stat(filepath.Join(f.root, "changes", "0002-beta.md")); statErr != nil {
		t.Errorf("beta no longer held: %v", statErr)
	}
	if _, statErr := os.Stat(filepath.Join(f.root, "changes", "0003-gamma.md")); statErr != nil {
		t.Errorf("gamma no longer queued: %v", statErr)
	}
	if _, statErr := os.Stat(filepath.Join(f.root, "changes", "archive", "0003-gamma.md")); !os.IsNotExist(statErr) {
		t.Errorf("gamma archived: %v", statErr)
	}
	if strings.Contains(nextRead(t, f.root, "changes/0003-gamma.md"), "phase:") {
		t.Error("gamma was started")
	}
	got := runInvocations(t, f)
	if len(got) != 4 || got[3] != "beta|evals|"+f.root+"|/fixture/run-bin" {
		t.Errorf("failure invocation order = %#v", got)
	}
}

func Test_RUN_016_RUN_025_RUN_026_BlockThenApplyIndependent(t *testing.T) {
	f := runBlockedDependencyFixture(t)
	r, err := runner.Run(context.Background(), f.request(0, false))
	assertRunBlockedAlpha(t, f, err)
	assertRunApplied(t, f, r.Applied, "gamma")
	assertRunBetaWaiting(t, f)
	if q, queueErr := project.Queue(f.root); queueErr != nil || len(q) != 2 || q[0].Slug != "alpha" || q[1].Slug != "beta" {
		t.Errorf("remaining queue = %#v, %v", q, queueErr)
	}
	if got := runInvocations(t, f); len(got) != 5 || got[0] != "alpha|evals|"+f.root+"|/fixture/run-bin" || got[1] != got[0] || got[2] != "gamma|evals|"+f.root+"|/fixture/run-bin" || !strings.HasPrefix(got[3], "gamma|audit|") || !strings.HasSuffix(got[3], "|/fixture/run-bin") || got[4] != "gamma|impl|"+f.root+"|/fixture/run-bin" {
		t.Errorf("blocked continuation agent calls = %#v", got)
	}
}

func Test_RUN_025_RUN_026_PositiveMaxRetainsBlock(t *testing.T) {
	f := runBlockedDependencyFixture(t)
	nextWrite(t, f.root, "changes/0004-later.md", "---\nmodule: gamma\nbases: {}\n---\n\n## Motivation\nLater independent work.\n\n## Interface\n\n## Added\n\n### new:later\nGamma MUST return another value.\n\n## Modified\n\n## Removed\n\n## Decisions\n")
	nextCommit(t, f.root, "later independent work")
	for _, d := range project.Check(f.root) {
		if !d.Warning {
			t.Fatalf("invalid Max fixture: %#v", d)
		}
	}
	r, err := runner.Run(context.Background(), f.request(1, false))
	assertRunBlockedAlpha(t, f, err)
	assertRunApplied(t, f, r.Applied, "gamma")
	assertRunBetaWaiting(t, f)
	if later := nextRead(t, f.root, "changes/0004-later.md"); strings.Contains(later, "run:") || strings.Contains(later, "phase:") {
		t.Errorf("Max started later work: %q", later)
	}
	if got := runInvocations(t, f); len(got) != 5 {
		t.Errorf("Max agent calls = %#v, want exhausted alpha then one applied gamma", got)
	}
}


# Eval: packages/runner/evals/time_limit_test.go
package evals_test

import (
	"context"
	"errors"
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"testing"
	"time"

	"github.com/lurkshark/fireweed/packages/runner"
	"github.com/lurkshark/fireweed/packages/workflow"
)

// The ordinary fixture hook supplies fixed phase evidence so these cases measure
// Run scheduling rather than Go compilation time. The agent still writes work.
func timeFastHook(t *testing.T, f runFixture) {
	t.Helper()
	nextWrite(t, f.root, ".fireweed/eval.sh", `#!/bin/sh
case "$1" in alpha) prefix=ALP;; beta) prefix=BET;; gamma) prefix=GAM;; *) exit 35;; esac
phase=''; active=''
for file in changes/*.md; do
  [ -f "$file" ] || continue
  [ -z "$(sed -n 's/^blocked: //p' "$file" | head -1)" ] || continue
  case "$(sed -n 's/^phase: //p' "$file" | head -1)" in
    evals|impl) phase=$(sed -n 's/^phase: //p' "$file" | head -1); active=$(sed -n 's/^module: //p' "$file" | head -1); break;;
  esac
done
[ -n "$phase" ] || exit 36
if [ "$1" != "$active" ]; then
  printf '<testsuite><testcase name="%s-001" classname="fixture"/></testsuite>' "$prefix" > "$2"
  exit 0
fi
if [ "$phase" = evals ] && [ ! -f "packages/$1/evals/added_test.go" ]; then
  printf '<testsuite><testcase name="%s-001" classname="fixture"/><testcase name="%s-002" classname="fixture"/></testsuite>' "$prefix" "$prefix" > "$2"
  exit 0
fi
if [ "$phase" = evals ]; then result='<failure message="new value not implemented"/>'; code=1
else result=''; code=0; fi
printf '<testsuite><testcase name="%s-001" classname="fixture"/><testcase name="%s-002" classname="fixture">%s</testcase></testsuite>' "$prefix" "$prefix" "$result" > "$2"
exit "$code"
`)
	config := nextRead(t, f.root, "fireweed.yaml")
	nextWrite(t, f.root, "fireweed.yaml", strings.Replace(config, "timeout: 50ms\n", "timeout: 15s\n", 1))
	nextCommit(t, f.root, "bounded local time hook")
}

func timeAgentAfterWork(t *testing.T, f runFixture, body string) {
	t.Helper()
	script := nextRead(t, f.agents, "worker.sh")
	anchor := "printf '%s-%s' \"$module\" \"$phase\"\n"
	if !strings.Contains(script, anchor) {
		t.Fatal("fixture agent insertion point missing")
	}
	nextWrite(t, f.agents, "worker.sh", strings.Replace(script, anchor, body+anchor, 1))
}

func timeStop(t *testing.T, err error, limit string) {
	t.Helper()
	if err == nil || !runner.IsTimeStop(err) || !strings.Contains(err.Error(), limit) {
		t.Errorf("clean time stop = %v, want classified nonnil error naming %s", err, limit)
	}
}

func timeHeldWork(t *testing.T, f runFixture, slug, phase, marker, want, head string) workflow.State {
	t.Helper()
	state := usageHeld(t, f.root, slug, phase, "", head, "")
	if !strings.Contains(nextRead(t, f.root, marker), want) {
		t.Errorf("interrupted %s work missing", slug)
	}
	if got := nextGit(t, f.root, "rev-list", "--count", head+"..HEAD"); got != "0" {
		t.Errorf("interrupted step committed %s times", got)
	}
	if state.Change.Added[0].ID != runModules[indexRunModule(slug)].prefix+"-002" {
		t.Errorf("held %s ID = %q", slug, state.Change.Added[0].ID)
	}
	return state
}

func Test_RUN_036_RUN_037_OneBudgetAcrossChangesRetainsApplied(t *testing.T) {
	f := newRunFixture(t, 2, false, false)
	timeFastHook(t, f)
	timeAgentAfterWork(t, f, `if [ "$module" = alpha ]; then sleep 1; fi
if [ "$module" = beta ] && [ "$phase" = evals ]; then
  printf 'TIME_HELD_WORK\n' > packages/beta/evals/time-work.txt
  sleep 6
fi
`)
	audit := nextRead(t, f.agents, "auditor.sh")
	nextWrite(t, f.agents, "auditor.sh", strings.Replace(audit, "sleep 0.12", "sleep 1", 1))
	req := f.request(0, false)
	req.For = 10 * time.Second
	start := time.Now()
	r, err := runner.Run(context.Background(), req)
	elapsed := time.Since(start)
	timeStop(t, err, "10s")
	if elapsed > 14*time.Second {
		t.Errorf("total deadline waited %s; budget may have reset after alpha", elapsed)
	}
	if len(r.Applied) == 1 {
		assertRunApplied(t, f, r.Applied, "alpha")
		timeHeldWork(t, f, "beta", "evals", "packages/beta/evals/time-work.txt", "TIME_HELD_WORK", nextGit(t, f.root, "rev-parse", "HEAD"))
	} else {
		t.Errorf("Applied count = %d, want one retained alpha", len(r.Applied))
	}
	if got := runInvocations(t, f); len(got) != 4 || !strings.HasPrefix(got[3], "beta|evals|") {
		t.Errorf("invocations through held beta = %#v", got)
	}
}

func Test_RUN_036_ZeroForKeepsOrdinaryRunUnbounded(t *testing.T) {
	f := newRunFixture(t, 1, false, false)
