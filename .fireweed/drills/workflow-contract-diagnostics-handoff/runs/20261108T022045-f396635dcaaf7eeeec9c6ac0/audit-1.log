}

func Test_RUN_037_RUN_039_AgentDeadlineRetainsHeldWork(t *testing.T) {
	f := newRunFixture(t, 1, false, false)
	timeFastHook(t, f)
	timeAgentAfterWork(t, f, `if [ "$phase" = evals ]; then
  printf 'TIME_HELD_WORK\n' > packages/alpha/evals/time-work.txt
  sleep 4
fi
`)
	head := nextGit(t, f.root, "rev-parse", "HEAD")
	original, startErr := workflow.Start(f.root, "alpha")
	if startErr != nil {
		t.Fatalf("start interrupted agent step: %v", startErr)
	}
	req := f.request(0, false)
	req.For = 2 * time.Second
	r, err := runner.Run(context.Background(), req)
	timeStop(t, err, "2s")
	if err != nil && !runner.IsTimeStop(fmt.Errorf("outer: %w", err)) {
		t.Errorf("wrapped time stop classification = %v", err)
	}
	if len(r.Applied) != 0 {
		t.Errorf("interrupted agent applied %d changes", len(r.Applied))
	} else {
		held := timeHeldWork(t, f, "alpha", "evals", "packages/alpha/evals/time-work.txt", "TIME_HELD_WORK", head)
		if held.Run != original.Run || held.ClaimOID != original.ClaimOID || held.Phase != original.Phase || held.Change.Added[0].ID != original.Change.Added[0].ID || held.Head != original.Head {
			t.Errorf("interrupted agent identity changed: held=%#v, original=%#v", held, original)
		}
	}
}

func Test_RUN_037_VerificationDeadlineRetainsHeldWork(t *testing.T) {
	f := newRunFixture(t, 1, false, false)
	timeFastHook(t, f)
	hook := nextRead(t, f.root, ".fireweed/eval.sh")
	anchor := "if [ \"$phase\" = evals ]; then result="
	addition := `if [ "$phase" = evals ]; then
  printf 'TIME_HELD_WORK\n' > packages/alpha/evals/time-work.txt
  sleep 4
fi
`
	if !strings.Contains(hook, anchor) {
		t.Fatal("fixture hook insertion point missing")
	}
	nextWrite(t, f.root, ".fireweed/eval.sh", strings.Replace(hook, anchor, addition+anchor, 1))
	nextCommit(t, f.root, "bounded verification interruption")
	head := nextGit(t, f.root, "rev-parse", "HEAD")
	original, startErr := workflow.Start(f.root, "alpha")
	if startErr != nil {
		t.Fatalf("start interrupted verification step: %v", startErr)
	}
	req := f.request(0, false)
	req.For = 2 * time.Second
	r, err := runner.Run(context.Background(), req)
	invocations, invocationErr := os.ReadFile(filepath.Join(f.agents, "invocations"))
	workPath := filepath.Join(f.root, "packages/alpha/evals/added_test.go")
	workInfo, workStatErr := os.Stat(workPath)
	work, workReadErr := os.ReadFile(workPath)
	markerPath := filepath.Join(f.root, "packages/alpha/evals/time-work.txt")
	markerInfo, markerStatErr := os.Stat(markerPath)
	marker, markerReadErr := os.ReadFile(markerPath)
	reportPath := filepath.Join(f.root, ".fireweed", "runs", original.Run, "evals", "alpha.json")
	reportInfo, reportStatErr := os.Stat(reportPath)
	report, reportReadErr := os.ReadFile(reportPath)
	held, heldErr := workflow.Current(f.root, "alpha")
	readGit := func(args ...string) (string, error) {
		command := exec.Command("git", args...)
		command.Dir = f.root
		output, commandErr := command.Output()
		return strings.TrimSpace(string(output)), commandErr
	}
	actualHead, headErr := readGit("rev-parse", "HEAD")
	claimRef, claimErr := readGit("for-each-ref", "--format=%(refname)", "refs/fireweed/claims")
	commits, commitsErr := readGit("rev-list", "--count", head+"..HEAD")
	t.Logf("RUN-037 verification stop: result=%#v error=%v clean_time_stop=%t", r, err, runner.IsTimeStop(err))
	t.Logf("agent invocations: read_error=%v content=%q", invocationErr, invocations)
	t.Logf("agent work %s: exists=%t stat_error=%v read_error=%v content=%q", workPath, workStatErr == nil && workInfo != nil, workStatErr, workReadErr, work)
	t.Logf("hook marker %s: exists=%t stat_error=%v read_error=%v content=%q", markerPath, markerStatErr == nil && markerInfo != nil, markerStatErr, markerReadErr, marker)
	t.Logf("verification report %s: exists=%t stat_error=%v read_error=%v content=%q", reportPath, reportStatErr == nil && reportInfo != nil, reportStatErr, reportReadErr, report)
	t.Logf("held identity: state=%#v read_error=%v original phase=%q run=%q claim=%q assigned=%#v HEAD=%q; actual HEAD=%q error=%v; claim refs=%q error=%v; commits=%q error=%v", held, heldErr, original.Phase, original.Run, original.ClaimOID, original.Change.Added, original.Head, actualHead, headErr, claimRef, claimErr, commits, commitsErr)
	timeStop(t, err, "2s")
	if len(r.Applied) != 0 {
		t.Errorf("interrupted verification applied %d changes", len(r.Applied))
	}
	if markerReadErr != nil || !strings.Contains(string(marker), "TIME_HELD_WORK") {
		t.Errorf("interrupted alpha work missing: marker=%q read_error=%v", marker, markerReadErr)
	}
	if workStatErr != nil {
		t.Errorf("agent work lost before interrupted verification: %v", workStatErr)
	}
	if commitsErr != nil || commits != "0" {
		t.Errorf("interrupted step committed %s times: %v", commits, commitsErr)
	}
	if heldErr != nil {
		t.Errorf("held state: %v", heldErr)
	} else {
		if held.Phase != "evals" || held.Run == "" || held.Head != head || held.ClaimOID == "" || held.Snapshot.Root != f.root || len(held.Change.Added) != 1 || (len(held.Change.Added) == 1 && held.Change.Added[0].ID != "ALP-002") {
			t.Errorf("held identity changed: phase=%q run=%q head=%q claim=%q added=%#v snapshot=%q", held.Phase, held.Run, held.Head, held.ClaimOID, held.Change.Added, held.Snapshot.Root)
		}
		if held.Run != original.Run || held.ClaimOID != original.ClaimOID || held.Phase != original.Phase || len(held.Change.Added) != len(original.Change.Added) || (len(held.Change.Added) == 1 && len(original.Change.Added) == 1 && held.Change.Added[0].ID != original.Change.Added[0].ID) || held.Head != original.Head {
			t.Errorf("interrupted verification identity changed: held=%#v, original=%#v", held, original)
		}
	}
	if headErr != nil || actualHead != head {
		t.Errorf("HEAD = %s, want %s: %v", actualHead, head, headErr)
	}
	if claimErr != nil || claimRef != "refs/fireweed/claims/alpha" {
		t.Errorf("held claim ref = %q: %v", claimRef, claimErr)
	}
}

func Test_RUN_038_UsageWaitPreflightStopsBeforeWaiting(t *testing.T) {
	f := newRunFixture(t, 1, false, false)
	timeFastHook(t, f)
	usagePolicy(t, f.root, "limit_wait: 1m\nlimit_budget: 2m\n")
	runUsageAgent(t, f, "alpha/evals")
	head := nextGit(t, f.root, "rev-parse", "HEAD")
	req := f.request(0, false)
	req.For = 5 * time.Second
	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
	defer cancel()
	start := time.Now()
	r, err := runner.Run(ctx, req)
	elapsed := time.Since(start)
	timeStop(t, err, "5s")
	if elapsed >= 3*time.Second {
		t.Errorf("usage wait preflight took %s", elapsed)
	}
	if len(r.Applied) != 0 {
		t.Errorf("preflight applied %d changes", len(r.Applied))
	} else {
		timeHeldWork(t, f, "alpha", "evals", "packages/alpha/evals/usage_test.go", "USAGE_PARTIAL_WORK", head)
	}
}

func Test_RUN_039_ClassifierAndParentCancellation(t *testing.T) {
	if runner.IsTimeStop(nil) || runner.IsTimeStop(errors.New("ordinary")) || runner.IsTimeStop(context.Canceled) {
		t.Error("ordinary, nil or parent cancellation classified as time stop")
	}
	f := newRunFixture(t, 1, false, false)
	timeFastHook(t, f)
	usagePolicy(t, f.root, "limit_wait: 1m\nlimit_budget: 0s\n")
	runUsageAgent(t, f, "alpha/evals")
	req := f.request(0, false)
	_, usageErr := runner.Run(context.Background(), req)
	if !runner.IsUsageStop(usageErr) || runner.IsTimeStop(usageErr) {
		t.Errorf("usage stop classification = %v", usageErr)
	}

	other := newRunFixture(t, 1, false, false)
	timeFastHook(t, other)
	timeAgentAfterWork(t, other, `if [ "$phase" = evals ]; then sleep 8; fi
`)
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
	defer cancel()
	parentReq := other.request(0, false)
	parentReq.For = 10 * time.Second
	_, parentErr := runner.Run(ctx, parentReq)
	if !errors.Is(parentErr, context.DeadlineExceeded) || runner.IsTimeStop(parentErr) {
		t.Errorf("parent cancellation = %v", parentErr)
	}
}

func Test_RUN_040_EarlierBlockRetainsCauseBeforeTimeStop(t *testing.T) {
	f := runBlockedDependencyFixture(t)
	timeFastHook(t, f)
	timeAgentAfterWork(t, f, `if [ "$module" = gamma ] && [ "$phase" = evals ]; then
  printf 'TIME_HELD_WORK\n' > packages/gamma/evals/time-work.txt
  while :; do sleep 1; done
fi
`)
	req := f.request(0, false)
	req.For = 8 * time.Second
	r, err := runner.Run(context.Background(), req)
	if err == nil || !strings.Contains(err.Error(), "P2-01: no fail-first case for ALP-002") || !strings.Contains(err.Error(), "refs/fireweed/attempts/alpha/1") || !strings.Contains(err.Error(), "8s") || runner.IsTimeStop(err) {
		t.Errorf("combined block and time failure: Applied=%d, err=%v", len(r.Applied), err)
	}
	if saved := nextGit(t, f.root, "for-each-ref", "--format=%(objectname)", "refs/fireweed/attempts/alpha/1"); saved == "" {
		t.Error("blocked alpha lost saved attempt ref")
	}
	if len(r.Applied) != 0 {
		t.Errorf("blocked run applied %d changes", len(r.Applied))
	} else {
		timeHeldWork(t, f, "gamma", "evals", "packages/gamma/evals/time-work.txt", "TIME_HELD_WORK", nextGit(t, f.root, "rev-parse", "HEAD"))
	}
	assertRunBetaWaiting(t, f)
}


# Eval: packages/runner/evals/usage_test.go
package evals_test

import (
	"context"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"reflect"
	"strings"
	"testing"
	"time"

	"github.com/lurkshark/fireweed/packages/runner"
	"github.com/lurkshark/fireweed/packages/workflow"
)

func usagePolicy(t *testing.T, root, policy string) {
	t.Helper()
	nextWrite(t, root, "fireweed.yaml", nextRead(t, root, "fireweed.yaml")+"limit_patterns: [RATE LIMIT]\n"+policy)
	nextCommit(t, root, "fixture usage policy")
}

// These additions run inside the existing fixture agent after it records its
// invocation and prompt. They keep all work in the fixture repository.
func nextUsageAgent(t *testing.T, f nextFixture, behavior string) {
	t.Helper()
	script := nextRead(t, f.logDir, "worker.sh")
	var addition string
	switch behavior {
	case "first":
		addition = `if [ "$phase" = evals ] && [ "$attempt" -eq 1 ]; then
  printf 'package evals\n// USAGE_PARTIAL_WORK\n' > packages/alpha/evals/partial_test.go
  printf 'limited evals'; printf 'RATE LIMIT' >&2; exit 9
fi
`
	case "twice":
		addition = `if [ "$phase" = evals ] && [ "$attempt" -le 2 ]; then
  printf 'package evals\n// USAGE_PARTIAL_WORK\n' > packages/alpha/evals/partial_test.go
  printf 'limited evals'; printf 'RATE LIMIT' >&2; exit 9
fi
`
	case "always":
		addition = `if [ "$phase" = evals ]; then
  printf 'package evals\n// USAGE_PARTIAL_WORK\n' > packages/alpha/evals/partial_test.go
  printf 'limited evals'; printf 'RATE LIMIT' >&2; exit 9
fi
`
	case "feedback":
		addition = `if [ "$phase" = evals ] && [ "$attempt" -eq 1 ]; then
  cat > packages/alpha/evals/next_test.go <<'GO'
package evals
import ("testing"; "example.invalid/next-fixture/packages/alpha")
func Test_ALP_002_NewValue(t *testing.T) { if alpha.Value() != "old" { t.Fatal("wrong") } }
GO
  printf 'package evals\n// RETAINED_EVAL_WORK\n' > packages/alpha/evals/retained_test.go
  printf 'first verification'; exit 0
fi
if [ "$phase" = evals ] && [ "$attempt" -eq 2 ]; then
  printf 'limited evals'; printf 'RATE LIMIT' >&2; exit 9
fi
`
	case "phases":
		addition = `if { [ "$phase" = evals ] || [ "$phase" = impl ]; } && [ "$attempt" -eq 1 ]; then
  if [ "$phase" = impl ]; then printf '// USAGE_IMPL_WORK\n' >> packages/alpha/internal/value.go; fi
  printf 'limited %s' "$phase"; printf 'RATE LIMIT' >&2; exit 9
fi
`
	default:
		t.Fatal("unknown fixture behavior")
	}
	anchor := "case \"$2/$phase\" in\n"
	if !strings.Contains(script, anchor) {
		t.Fatal("fixture agent insertion point missing")
	}
	nextWrite(t, f.logDir, "worker.sh", strings.Replace(script, anchor, addition+anchor, 1))
}

func runUsageAgent(t *testing.T, f runFixture, targets string) {
	t.Helper()
	script := nextRead(t, f.agents, "worker.sh")
	anchor := "if [ \"$2\" = fail-beta ]"
	addition := fmt.Sprintf(`case "$module/$phase" in
  %s)
    count_file="$1/usage-$module-$phase"
    if [ ! -f "$count_file" ]; then
      printf 1 > "$count_file"
      printf 'package evals\n// USAGE_PARTIAL_WORK\n' > "packages/$module/evals/usage_test.go"
      printf 'limited %%s %%s' "$module" "$phase"
      printf 'RATE LIMIT' >&2
      exit 9
    fi
    ;;
esac
`, targets)
	if !strings.Contains(script, anchor) {
		t.Fatal("run fixture agent insertion point missing")
	}
	nextWrite(t, f.agents, "worker.sh", strings.Replace(script, anchor, addition+anchor, 1))
}

func usageHeld(t *testing.T, root, slug, phase, run, head, claim string) workflow.State {
	t.Helper()
	state, err := workflow.Current(root, slug)
	if err != nil {
		t.Fatalf("held state: %v", err)
	}
	if state.Phase != phase || state.Run == "" || (run != "" && state.Run != run) || state.Head != head || state.ClaimOID == "" || (claim != "" && state.ClaimOID != claim) || state.Snapshot.Root != root || len(state.Change.Added) != 1 || state.Change.Added[0].ID == "" {
		t.Errorf("held identity changed: phase=%q run=%q head=%q claim=%q added=%#v", state.Phase, state.Run, state.Head, state.ClaimOID, state.Change.Added)
	}
	if got := nextGit(t, root, "rev-parse", "HEAD"); got != head {
		t.Errorf("HEAD = %s, want %s", got, head)
	}
	if got := nextGit(t, root, "for-each-ref", "--format=%(refname)", "refs/fireweed/claims"); got != "refs/fireweed/claims/"+slug {
		t.Errorf("held claim ref = %q", got)
	}
	return state
}

func Test_RUN_029_InvalidUsagePolicyPrecedesFreshStart(t *testing.T) {
	for _, tc := range []struct{ name, policy string }{
		{"bad wait", "limit_wait: nonsense\n"},
		{"bad budget", "limit_budget: nonsense\n"},
		{"zero wait", "limit_wait: 0s\n"},
		{"negative budget", "limit_budget: -1s\n"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			f := newNextFixture(t, true, true, "normal")
			usagePolicy(t, f.root, tc.policy)
			head := nextGit(t, f.root, "rev-parse", "HEAD")
			change := nextRead(t, f.root, nextChange)
			_, err := f.run(false)
			if err == nil || !strings.Contains(err.Error(), "C01") {
				t.Errorf("invalid policy error = %v, want C01", err)
			}
			if got, readErr := os.ReadFile(filepath.Join(f.root, nextChange)); readErr != nil || string(got) != change {
				t.Errorf("invalid policy changed queued document: %v", readErr)
			}
			if nextGit(t, f.root, "rev-parse", "HEAD") != head || nextGit(t, f.root, "for-each-ref", "--format=%(refname)", "refs/fireweed/claims") != "" {
				t.Error("invalid policy changed HEAD or claimed work")
			}
			f.noAgent(t)
		})
	}
}

func Test_RUN_029_RUN_031_DefaultUsageDurationsStopImmediately(t *testing.T) {
	for _, tc := range []struct{ name, policy, wait, budget string }{
		{"default wait", "limit_budget: 0s\n", "30m", "0s"},
		{"default budget", "limit_wait: 5h\n", "5h", "4h"},
	} {
		t.Run(tc.name, func(t *testing.T) {
			f := newNextFixture(t, true, true, "normal")
			usagePolicy(t, f.root, tc.policy)
			nextUsageAgent(t, f, "first")
			head := nextGit(t, f.root, "rev-parse", "HEAD")
			r, err := f.run(false)
			if err == nil || !runner.IsUsageStop(err) || !strings.Contains(err.Error(), tc.wait) || !strings.Contains(err.Error(), tc.budget) || !strings.Contains(err.Error(), "0s") {
				t.Errorf("default policy stop = %v", err)
			}
			if len(r.Steps) != 1 || !r.Steps[0].Agent.UsageLimit || r.Steps[0].Agent.ExitCode != 9 || r.State.Phase != "evals" {
				t.Errorf("captured stop = %#v", r)
			}
			state := usageHeld(t, f.root, "next", "evals", r.State.Run, head, r.State.ClaimOID)
			if state.Change.Added[0].ID != "ALP-002" || !strings.Contains(nextRead(t, f.root, "packages/alpha/evals/partial_test.go"), "USAGE_PARTIAL_WORK") || len(nextInvocations(t, f)) != 1 {
				t.Error("stop lost assigned ID, partial work, or invocation")
			}
		})
	}
}

func Test_RUN_030_RUN_031_RUN_033_ShortBudgetResumeOwnedStep(t *testing.T) {
	f := newNextFixture(t, true, true, "normal")
	usagePolicy(t, f.root, "limit_wait: 5ms\nlimit_budget: 5ms\nattempts: 1\n")
	nextUsageAgent(t, f, "twice")
	head := nextGit(t, f.root, "rev-parse", "HEAD")
	first, err := f.run(false)
	if err == nil || !runner.IsUsageStop(err) || strings.Count(err.Error(), "5ms") < 3 || len(first.Steps) != 2 || !first.Steps[0].Agent.UsageLimit || !first.Steps[1].Agent.UsageLimit {
		t.Fatalf("short-budget stop = %#v, %v", first, err)
	}
	state := usageHeld(t, f.root, "next", "evals", first.State.Run, head, first.State.ClaimOID)
	partialWork := nextRead(t, f.root, "packages/alpha/evals/partial_test.go")
	if state.Change.Added[0].ID != "ALP-002" || !strings.Contains(partialWork, "USAGE_PARTIAL_WORK") {
		t.Error("held eval work or assigned ID lost")
	}
	approved := state.Snapshot
	if approved.Root != f.root || approved.Config["limit_wait"] != "5ms" || approved.Config["limit_budget"] != "5ms" || fmt.Sprint(approved.Config["attempts"]) != "1" {
		t.Errorf("held approved snapshot has wrong fixture policy: root=%q wait=%v budget=%v attempts=%v", approved.Root, approved.Config["limit_wait"], approved.Config["limit_budget"], approved.Config["attempts"])
	}
	approvedSpec := ""
	for _, module := range approved.Modules {
		if module.Name == "alpha" {
			approvedSpec = module.Document.Body
		}
	}
	if !strings.Contains(approvedSpec, "### ALP-002") || !strings.Contains(approvedSpec, "Alpha MUST return the new value.") {
		t.Errorf("held approved snapshot lacks projected alpha spec: %q", approvedSpec)
	}
	if got := nextGit(t, f.root, "rev-list", "--count", head+"..HEAD"); got != "0" {
		t.Errorf("stop committed %s times", got)
	}
	second, err := f.run(false)
	if err != nil || second.State.Phase != "applied" || second.State.Run != state.Run || len(second.Steps) != 3 || second.Steps[0].Phase != "evals" || len(nextInvocations(t, f)) != 5 {
		t.Errorf("owned resume = %#v, %v", second, err)
	}
	if !strings.Contains(nextRead(t, f.root, "changes/archive/0001-next.md"), "ALP-002") {
		t.Error("resume lost assigned ID")
	}
	if got := nextRead(t, f.root, "packages/alpha/evals/partial_test.go"); got != partialWork {
		t.Errorf("resume changed held partial eval work: got %q, want %q", got, partialWork)
	}
	resumedSpec := ""
	for _, module := range second.State.Snapshot.Modules {
		if module.Name == "alpha" {
			resumedSpec = module.Document.Body
		}
	}
	if second.State.Snapshot.Root != approved.Root || second.State.Snapshot.Config["limit_wait"] != approved.Config["limit_wait"] || second.State.Snapshot.Config["limit_budget"] != approved.Config["limit_budget"] || fmt.Sprint(second.State.Snapshot.Config["attempts"]) != fmt.Sprint(approved.Config["attempts"]) || resumedSpec != approvedSpec {
		t.Errorf("resumed State did not use held approved snapshot: root=%q wait=%v budget=%v attempts=%v projected alpha=%q", second.State.Snapshot.Root, second.State.Snapshot.Config["limit_wait"], second.State.Snapshot.Config["limit_budget"], second.State.Snapshot.Config["attempts"], resumedSpec)
	}
}

func Test_RUN_033_OwnedResumeUsesApprovedUsageBudget(t *testing.T) {
	f := newNextFixture(t, true, true, "normal")
	usagePolicy(t, f.root, "limit_wait: 5ms\nlimit_budget: 5ms\nattempts: 1\n")
	nextUsageAgent(t, f, "always")
	head := nextGit(t, f.root, "rev-parse", "HEAD")
	first, err := f.run(false)
	if err == nil || !runner.IsUsageStop(err) || len(first.Steps) != 2 {
		t.Fatalf("first approved-budget stop = %#v, %v", first, err)
	}
	for i, step := range first.Steps {
		if step.Phase != "evals" || !step.Agent.UsageLimit || step.Agent.ExitCode != 9 {
			t.Errorf("first invocation %d = %#v", i, step)
		}
	}
	held := usageHeld(t, f.root, "next", "evals", first.State.Run, head, first.State.ClaimOID)
	approved := held.Snapshot
	if approved.Config["limit_budget"] != "5ms" || held.Change.Added[0].ID != "ALP-002" {
		t.Fatalf("approved state lost budget or assigned ID: %#v", held)
	}
	partialWork := nextRead(t, f.root, "packages/alpha/evals/partial_test.go")
	if !strings.Contains(partialWork, "USAGE_PARTIAL_WORK") || len(nextInvocations(t, f)) != 2 {
		t.Fatal("first stop lost partial work or usage invocations")
	}
	config := nextRead(t, f.root, "fireweed.yaml")
	if !strings.Contains(config, "limit_budget: 5ms\n") {
		t.Fatal("fixture budget missing")
	}
	unapproved := strings.Replace(config, "limit_budget: 5ms\n", "limit_budget: 0s\n", 1)
	nextWrite(t, f.root, "fireweed.yaml", unapproved)

	second, err := f.run(false)
	if err == nil || !runner.IsUsageStop(err) || len(second.Steps) != 2 {
		t.Fatalf("resume with approved budget = %#v, %v", second, err)
	}
	for i, step := range second.Steps {
		if step.Phase != "evals" || !step.Agent.UsageLimit || step.Agent.ExitCode != 9 {
			t.Errorf("resumed invocation %d = %#v", i, step)
		}
	}
	resumed := usageHeld(t, f.root, "next", "evals", held.Run, head, held.ClaimOID)
	if resumed.Change.Added[0].ID != held.Change.Added[0].ID || second.State.Run != held.Run || second.State.Phase != held.Phase || second.State.Head != head || second.State.ClaimOID != held.ClaimOID || !reflect.DeepEqual(second.State.Snapshot, approved) || !reflect.DeepEqual(resumed.Snapshot, approved) {
		t.Errorf("resume changed approved State: returned=%#v held=%#v", second.State, resumed)
	}
	if got := nextRead(t, f.root, "packages/alpha/evals/partial_test.go"); got != partialWork {
		t.Errorf("resume changed partial eval work: got %q, want %q", got, partialWork)
	}
	if got := nextRead(t, f.root, "fireweed.yaml"); got != unapproved {
		t.Errorf("resume changed unapproved on-disk policy: %q", got)
	}
	if got := len(nextInvocations(t, f)); got != 4 {
		t.Errorf("total usage invocations = %d, want 4", got)
	}
	if got := nextGit(t, f.root, "rev-parse", "HEAD"); got != head {
		t.Errorf("resume committed: HEAD = %s, want %s", got, head)
	}
}

