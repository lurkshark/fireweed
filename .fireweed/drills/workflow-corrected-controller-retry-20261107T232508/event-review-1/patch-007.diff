+func StartFromAttempt(root,selector string,attempt int)(model.State,error){r,e:=rootOf(root);if e!=nil{return model.State{},e};if attempt<=0{return model.State{},coded("P01","attempt number must be positive")};c,e:=currentChange(r,selector);if e!=nil{return model.State{},e};ref:=fmt.Sprintf("refs/fireweed/attempts/%s/%d",c.Slug,attempt);oid,exists,e:=gitstore.Ref(r,ref);if e!=nil{return model.State{},e};if !exists{return model.State{},coded("P01","missing saved attempt "+strconv.Itoa(attempt))};if e=clean(r);e!=nil{return model.State{},e};eligible,e:=Eligible(r);if e!=nil{return model.State{},e};if len(eligible)==0||eligible[0].Path!=c.Path{return model.State{},coded("P01","change is not first eligible")};if _,exists,_:=gitstore.Ref(r,refName(c));exists{return model.State{},coded("P02","change already claimed")};s,e:=Start(r,c.Slug);if e!=nil{return s,e};patch,e:=gitBytes(r,"diff","--binary",oid+"^",oid,"--");if e!=nil{return s,e};cmd:=exec.Command("git","apply","--3way","-");cmd.Dir=r;cmd.Stdin=strings.NewReader(string(patch));out,err:=cmd.CombinedOutput();if err!=nil{return s,fmt.Errorf("restore attempt: %s: %w",strings.TrimSpace(string(out)),err)};currentPath:=filepath.Join(r,filepath.FromSlash(c.Path));saved,err:=os.ReadFile(currentPath);if err==nil{savedDoc,er:=contracts.ParseDocument(string(saved));if er==nil{approved:=s.Change.Document;for _,section:=range []string{"Audit","Questions"}{body,ok:=contracts.Section(savedDoc.Body,section);if ok{approved.Body=contracts.ReplaceSection(approved.Body,section,body)}};_ = writeChange(r,c,approved)}};return Current(r,c.Slug)}
