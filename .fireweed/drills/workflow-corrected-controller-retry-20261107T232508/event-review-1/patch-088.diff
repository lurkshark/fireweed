+func configuredBase(root string, s project.Snapshot) (string, string) {
+	remote, _ := s.Config["remote"].(string)
+	if remote == "" {
+		remote = "origin"
+	}
+	base, _ := s.Config["base"].(string)
+	if base == "" {
+		if ref, err := git(root, "symbolic-ref", "--short", "refs/remotes/"+remote+"/HEAD"); err == nil {
+			base = strings.TrimPrefix(ref, remote+"/")
+		}
+	}
+	if base == "" {
+		base = "main"
+	}
+	return base, remote
 }
