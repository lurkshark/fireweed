+func approvedCheck(root string,ch project.Change,c claim) error {
+ now,e:=textFile(root,ch.Path);if e!=nil{return e};a,e:=contracts.ParseDocument(c.Approved);if e!=nil{return e};b,e:=contracts.ParseDocument(now);if e!=nil{return e}
+ for _,key:=range []string{"run","phase"}{if !reflect.DeepEqual(a.Frontmatter[key],b.Frontmatter[key]){return code("P03","approved run or phase changed")}}
+ for _,key:=range []string{"audit_rounds","blocked"}{if !reflect.DeepEqual(a.Frontmatter[key],b.Frontmatter[key]){return code("P03","approved audit state changed")}}
+ for _,key:=range []string{"run","phase","audit_rounds","blocked"}{delete(a.Frontmatter,key);delete(b.Frontmatter,key)}
+ if !reflect.DeepEqual(a.Frontmatter,b.Frontmatter){return code("P03","approved author metadata changed")}
+ ab:=a.Body;bb:=b.Body
+ for _,key:=range []string{"Audit","Provenance","Questions"}{ab=contracts.ReplaceSection(ab,key,"");bb=contracts.ReplaceSection(bb,key,"")}
+ if strings.TrimSpace(ab)!=strings.TrimSpace(bb){return code("P03","approved author metadata changed")}
+ return nil
+}
+func zoneCheck(root string,ch project.Change,c claim)error{
+ changes,e:=gitstore.Changes(root,c.PhaseBase);if e!=nil{return e}
+ iface:=strings.TrimSpace(section(ch.Document.Body,"Interface"))!=""
+ ds:=checks.Zones(checks.ZoneRequest{Snapshot:c.Snapshot,Module:ch.Module,Phase:c.Phase,ChangePath:ch.Path,Base:c.PhaseBase,InterfaceDeclared:iface,Changes:changes})
+ if len(list(ch.Document.Frontmatter["eval_fix"]))>0{for _,change:=range changes{path:=change.Path;if path==ch.Path{continue};ok:=false;if c.Phase=="evals"{for _,m:=range c.Snapshot.Modules{if m.Name==ch.Module&&strings.HasPrefix(path,m.Dir+"/"){rel:=strings.TrimPrefix(path,m.Dir+"/");ok=contracts.ResolveZone(rel,m.Zones)=="evals"}}};if !ok{return code("Z01","eval_fix forbids %s in %s",path,c.Phase)}}}
+ for _,d:=range ds{if !d.Warning{return code(d.Code,"%s",d.Message)}};return nil
+}
+func enforced(m project.Module)[]contracts.Item{all:=mustItems(section(m.Document.Body,"Specs"));out:=[]contracts.Item{};for _,it:=range all{if !strings.Contains(strings.ToLower(it.Tag),"quarantine"){out=append(out,it)}};return out}
+func moduleFor(s project.Snapshot,name string)(project.Module,bool){for _,m:=range s.Modules{if m.Name==name{return m,true}};return project.Module{},false}
+func changedIDs(ch project.Change)[]string{out:=[]string{};for _,it:=range ch.Added{out=append(out,it.ID)};for _,it:=range ch.Modified{out=append(out,it.ID)};out=append(out,list(ch.Document.Frontmatter["fixes"])...);out=append(out,list(ch.Document.Frontmatter["eval_fix"])...);return out}
+func auditSubmission(ch project.Change,c claim)(string,bool,error){body:=section(ch.Document.Body,"Audit");checked:=regexp.MustCompile(`(?m)Checked IDs:\s*([^\n]+)`).FindStringSubmatch(body);noFind:=strings.Contains(body,"No findings");finding:=regexp.MustCompile(`(?m)^-\s*(?:\[untestable\]\s*)?([A-Z]+-\d+):\s*"([^"]+)"[^\n]*`).FindAllStringSubmatch(body,-1)
+ specs:=map[string]string{};for _,m:=range c.Snapshot.Modules{if m.Name==ch.Module{for _,it:=range mustItems(section(m.Document.Body,"Specs")){specs[it.ID]=it.Body}}}
+ retained:=[]string{};untestable:=false;prior:=sectionFromApproved(c.Approved,"Audit");for _,f:=range finding{if !strings.Contains(specs[f[1]],f[2]){continue};if frontInt(ch.Document.Frontmatter["audit_rounds"])>0&& !strings.Contains(prior,f[1]){continue};retained=append(retained,f[0]);if strings.Contains(f[0],"[untestable]"){untestable=true}}
+ if len(retained)>0{return strings.Join(retained,"\n")+"\n",untestable,nil}
+ if !noFind||len(checked)<2{return "",false,code("P09","audit requires Checked IDs and No findings")}
+ for _,id:=range changedIDs(ch){if !strings.Contains(checked[1],id){return "",false,code("P09","audit did not check %s",id)}}
+ return "No findings; checked "+strings.TrimSpace(checked[1])+"\n",false,nil
+}
+func sectionFromApproved(s,key string)string{d,e:=contracts.ParseDocument(s);if e!=nil{return ""};return section(d.Body,key)}
+func Verify(ctx context.Context,req model.Request)(model.Result,error){return verify(ctx,req)}
+func verify(ctx context.Context,req model.Request)(model.Result,error){var out model.Result;root,e:=canonical(req.Root);if e!=nil{return out,e};ch,c,oid,e:=owned(root,req.Change);if e!=nil{return out,e};st,e:=state(root,ch,c,oid);if e!=nil{return out,e};out.State=st;out.Reports=map[string]checks.Report{}
+ if c.Phase!="evals"&&c.Phase!="impl"&&c.Phase!="audit"{return out,code("P01","unsupported phase %s",c.Phase)}
+ if e=approvedCheck(root,ch,c);e!=nil{return out,e};if e=validateBases(root,ch);e!=nil{return out,e};if e=zoneCheck(root,ch,c);e!=nil{return out,e}
+ if c.Phase=="audit"{_,_,e=auditSubmission(ch,c);return out,e}
+ target,ok:=moduleFor(c.Snapshot,ch.Module);if !ok{return out,code("C01","module %s not found",ch.Module)}
+ modules:=[]project.Module{target};if c.Phase=="impl"&&!req.Quick{choice:=frontString(c.Snapshot.Config["verify_dependents"]);if choice==""{choice="direct"};for _,m:=range c.Snapshot.Modules{if m.Name==ch.Module{continue};include:=false;if choice=="all"{include=depends(c.Snapshot.Modules,m.Name,ch.Module)}else if choice=="direct"{for _,d:=range m.DependsOn{if d==ch.Module{include=true}}};if include{modules=append(modules,m)}}}
+ var first error;for _,m:=range modules{report,err:=checks.Evaluate(ctx,checks.HookRequest{Snapshot:c.Snapshot,Module:m.Name,Bin:req.Bin,Timeout:req.Timeout});out.Reports[m.Name]=report;_ =saveReport(root,c,m.Name,report)
+ specs:=enforced(m);if err==nil||len(report.Cases)>0{if cov:=checks.RequireCoverage(report,specs);cov!=nil&&first==nil{first=cov}}
+ if m.Name==ch.Module&&c.Phase=="evals"{if len(list(ch.Document.Frontmatter["eval_fix"]))>0{if pass:=checks.RequirePass(report,specs);pass!=nil&&first==nil{first=pass}}else{if ff:=checks.RequireFailFirst(report,changedIDs(ch),list(ch.Document.Frontmatter["already_satisfied"]));ff!=nil&&first==nil{first=ff}}}else if c.Phase=="impl"{if pass:=checks.RequirePass(report,specs);pass!=nil&&first==nil{first=pass}}
+ if err!=nil&&first==nil{first=err}}
+ out.Costs=moduleCosts(root,c,modules,out.Reports);out.Diagnostics=budgetWarnings(c.Snapshot.Config,out.Costs);_ =saveCosts(root,c,out.Costs,out.Diagnostics)
+ if c.Phase=="impl"&&!req.Quick{ds,err:=checks.Boundaries(ctx,checks.BoundaryRequest{Snapshot:c.Snapshot,Bin:req.Bin,Timeout:req.Timeout});if err!=nil{out.Diagnostics=append(out.Diagnostics,ds...);if first==nil{first=err}}}
+ return out,first
+}
+func saveReport(root string,c claim,name string,r checks.Report)error{dir:=filepath.Join(root,".fireweed","runs",c.Run,c.Phase);if e:=os.MkdirAll(dir,0755);e!=nil{return e};b,_:=json.MarshalIndent(r,"","  ");return os.WriteFile(filepath.Join(dir,name+".json"),b,0644)}
+func saveCosts(root string,c claim,costs []model.ModuleCost,ds []project.Diagnostic)error{dir:=filepath.Join(root,".fireweed","runs",c.Run,c.Phase);if e:=os.MkdirAll(dir,0755);e!=nil{return e};v:=model.CostSnapshot{Run:c.Run,Phase:c.Phase,RecordedAt:time.Now().UTC(),Modules:costs,Diagnostics:ds};b,e:=json.MarshalIndent(v,"","  ");if e!=nil{return e};return os.WriteFile(filepath.Join(dir,"costs.json"),b,0644)}
+func moduleCosts(root string,c claim,modules []project.Module,reports map[string]checks.Report)[]model.ModuleCost{out:=[]model.ModuleCost{};for _,m:=range modules{r:=reports[m.Name];v:=model.ModuleCost{Module:m.Name,CasesPerSpec:map[string]int{}};for _,it:=range enforced(m){v.CasesPerSpec[it.ID]=0};for _,tc:=range r.Cases{v.Seconds+=tc.Seconds;for _,id:=range tc.IDs{v.CasesPerSpec[id]++}};_ =filepath.WalkDir(filepath.Join(root,m.Dir),func(p string,d os.DirEntry,e error)error{if e!=nil||d.IsDir(){return nil};info,e:=d.Info();if e!=nil||!info.Mode().IsRegular(){return nil};rel,_:=filepath.Rel(filepath.Join(root,m.Dir),p);zone:=contracts.ResolveZone(filepath.ToSlash(rel),m.Zones);if zone!="evals"&&zone!="disposable"{return nil};b,e:=os.ReadFile(p);if e!=nil{return nil};n:=strings.Count(string(b),"\n");if len(b)>0&&b[len(b)-1]!='\n'{n++};if zone=="evals"{v.EvalLines+=n}else{v.DisposableLines+=n};return nil});out=append(out,v)};return out}
+func budgetWarnings(config map[string]any,costs []model.ModuleCost)[]project.Diagnostic{b:=nested(config,"budgets");limitSeconds:=900.0;if raw:=frontString(b["verify_time"]);raw!=""{if d,e:=time.ParseDuration(raw);e==nil{limitSeconds=d.Seconds()}};cases:=15;if n:=frontInt(b["cases_per_spec"]);n>0{cases=n};ratio:=4.0;if n:=frontInt(b["eval_ratio"]);n>0{ratio=float64(n)};out:=[]project.Diagnostic{};total:=0.0;for _,m:=range costs{total+=m.Seconds;for id,n:=range m.CasesPerSpec{if n>cases{out=append(out,project.Diagnostic{Code:"B02",Message:fmt.Sprintf("%s %s cases %d exceeds limit %d",m.Module,id,n,cases),Warning:true})}};if m.EvalLines>0&&(m.DisposableLines==0||float64(m.EvalLines)/float64(m.DisposableLines)>ratio){out=append(out,project.Diagnostic{Code:"B03",Message:fmt.Sprintf("%s eval/disposable ratio %d/%d exceeds limit %g",m.Module,m.EvalLines,m.DisposableLines,ratio),Warning:true})}};if total>limitSeconds{out=append(out,project.Diagnostic{Code:"B01",Message:fmt.Sprintf("verification seconds %g exceeds limit %g",total,limitSeconds),Warning:true})};return out}
+func Costs(root string)([]model.CostSnapshot,error){r,e:=canonical(root);if e!=nil{return nil,e};out:=[]model.CostSnapshot{};_ =filepath.WalkDir(filepath.Join(r,".fireweed","runs"),func(p string,d os.DirEntry,err error)error{if err!=nil{return nil};if d.IsDir()||d.Name()!="costs.json"{return nil};b,e:=os.ReadFile(p);if e!=nil{return nil};var s model.CostSnapshot;if json.Unmarshal(b,&s)==nil{out=append(out,s)};return nil});sort.Slice(out,func(i,j int)bool{return out[i].RecordedAt.Before(out[j].RecordedAt)});return out,nil}
+func provenance(c claim,req model.Request,reports map[string]checks.Report)string{agent:=req.Agent;if agent==""{agent="manual"};book,_:=assets.Playbook(c.Phase);if c.Phase=="impl"{d,_:=contracts.ParseDocument(c.Approved);if frontBool(d.Frontmatter["regenerate"]){book,_=assets.Playbook("regenerate")}};hash:=sha256.Sum256([]byte(book));total,fail,pass:=0,0,0;for _,r:=range reports{for _,tc:=range r.Cases{total++;if tc.Result=="pass"{pass++}else if tc.Result=="fail"||tc.Result=="error"{fail++}}};return fmt.Sprintf("- %s %s agent=%s fireweed=%s playbook=%s tests=%d failing=%d passing=%d\n",c.Phase,time.Now().UTC().Format(time.RFC3339Nano),agent,assets.Version(),hex.EncodeToString(hash[:]),total,fail,pass)}
