+func Done(ctx context.Context,req model.Request)(model.Result,error){
+ req.Quick=false
+ out,e:=verify(ctx,req);if e!=nil{return out,e}
+ root,e:=canonical(req.Root);if e!=nil{return out,e};ch,c,oid,e:=owned(root,req.Change);if e!=nil{return out,e}
+ before,e:=textFile(root,ch.Path);if e!=nil{return out,e};doc,e:=contracts.ParseDocument(before);if e!=nil{return out,e}
+ next:="";blocked:=false
+ switch c.Phase{
+ case "evals":next="audit";audit:=nested(c.Snapshot.Config,"audit");if enabled,ok:=audit["enabled"].(bool);ok&&!enabled{next="impl"}
+ case "audit":body,untestable,ae:=auditSubmission(ch,c);if ae!=nil{return out,ae};doc.Body=contracts.ReplaceSection(doc.Body,"Audit",body);if strings.HasPrefix(body,"-"){
+  rounds:=frontInt(doc.Frontmatter["audit_rounds"]);max:=2;if n:=frontInt(nested(c.Snapshot.Config,"audit")["max_rounds"]);n>0{max=n};if untestable||rounds>=max{blocked=true;next=c.Phase;doc.Frontmatter["blocked"]="audit findings";doc.Body=contracts.ReplaceSection(doc.Body,"Questions",body)}else{next="evals";doc.Frontmatter["audit_rounds"]=rounds+1}
+ }else{next="impl"}
+ case "impl":next="applied"
+ default:return out,code("P01","unsupported phase %s",c.Phase)
+ }
+ doc.Frontmatter["phase"]=next
+ line:=provenance(c,req,out.Reports);previous:=section(doc.Body,"Provenance");doc.Body=contracts.ReplaceSection(doc.Body,"Provenance",strings.TrimSpace(previous+"\n"+line)+"\n")
+ text,e:=render(doc);if e!=nil{return out,e}
+ if e=writeFile(root,ch.Path,text);e!=nil{return out,e}
+ var specPath,specBefore string
+ if next=="applied"{for _,m:=range c.Snapshot.Modules{if m.Name==ch.Module{specPath=filepath.ToSlash(filepath.Join(m.Dir,"SPEC.md"));break}};if specPath==""{_ =writeFile(root,ch.Path,before);return out,code("C01","module %s missing",ch.Module)};specBefore,e=textFile(root,specPath);if e!=nil{_ =writeFile(root,ch.Path,before);return out,e};newSpec,ae:=applySpec(specBefore,ch);if ae!=nil{_ =writeFile(root,ch.Path,before);return out,ae};if e=writeFile(root,specPath,newSpec);e!=nil{_ =writeFile(root,ch.Path,before);return out,e}
+  for _,d:=range project.Check(root){if !d.Warning{_ =writeFile(root,specPath,specBefore);_ =writeFile(root,ch.Path,before);return out,code(d.Code,"%s",d.Message)}}
+  archived:="changes/archive/"+filepath.Base(ch.Path);if e=os.MkdirAll(filepath.Join(root,"changes","archive"),0755);e!=nil{return out,e};if e=os.Rename(filepath.Join(root,ch.Path),filepath.Join(root,archived));e!=nil{return out,e}
+ }
+ if _,e=git(root,"add","-A");e!=nil{return out,e};if _,e=git(root,"commit","-m",fmt.Sprintf("fireweed %s %s",ch.Slug,c.Phase));e!=nil{return out,e}
+ head,e:=git(root,"rev-parse","HEAD");if e!=nil{return out,e};c.Phase=next;c.PhaseBase=head;c.Approved=text
+ if next=="applied"||blocked{_ =releaseClaim(root,ch,oid);out.State.ClaimOID="";if next=="applied"{ch.Path="changes/archive/"+filepath.Base(ch.Path)}}else{oid,e=saveClaim(root,ch,c,oid);if e!=nil{return out,e};out.State.ClaimOID=oid}
+ out.State.Change=ch;out.State.Change.Document=doc;out.State.Phase=next;out.State.PhaseBase=head;out.State.Head=head
+ if blocked{return out,code("P06","change blocked")};return out,nil
+}
+
+func applySpec(source string,ch project.Change)(string,error){doc,e:=contracts.ParseDocument(source);if e!=nil{return "",e};items,e:=contracts.ParseItems(section(doc.Body,"Specs"));if e!=nil{return "",e};byID:=map[string]contracts.Item{};order:=[]string{};for _,it:=range items{byID[it.ID]=it;order=append(order,it.ID)};for _,it:=range ch.Removed{delete(byID,it.ID)};for _,it:=range append(ch.Modified,ch.Added...){if _,ok:=byID[it.ID];!ok{order=append(order,it.ID)};byID[it.ID]=it};sort.Strings(order);unique:=map[string]bool{};lines:=[]string{};for _,id:=range order{if unique[id]{continue};unique[id]=true;if it,ok:=byID[id];ok{lines=append(lines,strings.TrimSpace(contracts.RenderItem(it)))}};doc.Body=contracts.ReplaceSection(doc.Body,"Specs",strings.Join(lines,"\n\n")+"\n")
+ if set:=nested(ch.Document.Frontmatter,"set");len(set)>0{for k,v:=range set{doc.Frontmatter[k]=v}}
+ decisions:=strings.TrimSpace(section(doc.Body,"Decisions"));removed:=strings.TrimSpace(section(ch.Document.Body,"Removed decisions"));if removed!=""{for _,entry:=range strings.Split(removed,"\n"){entry=strings.TrimSpace(entry);if entry!=""{decisions=strings.ReplaceAll(decisions,entry,"")}}};added:=strings.TrimSpace(section(ch.Document.Body,"Decisions"));if added!=""{for _,entry:=range strings.Split(added,"\n"){entry=strings.TrimSpace(entry);if entry!=""{if decisions!=""{decisions+="\n"};decisions+="- "+ch.Slug+": "+entry}}};doc.Body=contracts.ReplaceSection(doc.Body,"Decisions",strings.TrimSpace(decisions)+"\n")
+ return render(doc)
+}
+
+func Context(root,selector string,full bool)(string,error){r,e:=canonical(root);if e!=nil{return "",e};ch,c,_,e:=owned(r,selector);if e!=nil{return "",e};change,e:=textFile(r,ch.Path);if e!=nil{return "",e};var b strings.Builder;b.WriteString("# Change\n"+change+"\n# Projected spec\n");for _,m:=range c.Snapshot.Modules{if m.Name!=ch.Module{continue};v,_:=render(m.Document);b.WriteString(v+"\n");for _,pattern:=range m.Zones.Interface{_ =pattern};_ =filepath.WalkDir(filepath.Join(r,m.Dir),func(p string,d os.DirEntry,err error)error{if err!=nil||d.IsDir(){return nil};rel,_:=filepath.Rel(r,p);name:=filepath.ToSlash(rel);sub:=strings.TrimPrefix(name,m.Dir+"/");zone:=contracts.ResolveZone(sub,m.Zones);if zone=="interface"{v,_:=os.ReadFile(p);b.WriteString("\n## "+name+"\n"+string(v));return nil};if sub=="SPEC.md"{return nil};info,_:=d.Info();if info==nil{return nil};b.WriteString(fmt.Sprintf("\n%s %d bytes\n",name,info.Size()));if full{v,_:=os.ReadFile(p);b.Write(v)};return nil})};system,_:=textFile(r,"SYSTEM.md");b.WriteString("\n# SYSTEM\n"+system);bookName:=c.Phase;if c.Phase=="impl"&&frontBool(ch.Document.Frontmatter["regenerate"]){bookName="regenerate"};book,_:=assets.Playbook(bookName);b.WriteString("\n"+book);return b.String(),nil}
