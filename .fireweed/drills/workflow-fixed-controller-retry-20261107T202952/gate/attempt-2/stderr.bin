+func phaseSpecBaseCheck(root string, ch project.Change, c claim) error {
+	ids := append([]string{}, list(ch.Document.Frontmatter["fixes"])...)
+	for _, it := range append(ch.Modified, ch.Removed...) {
+		ids = append(ids, it.ID)
+	}
+	if len(ids) == 0 {
+		return nil
+	}
+	m, ok := moduleFor(c.Snapshot, ch.Module)
+	if !ok {
+		return nil
+	}
+	path := filepath.ToSlash(filepath.Join(m.Dir, "SPEC.md"))
+	base, e := gitstore.ReadAt(root, c.PhaseBase, path)
+	if e != nil {
+		return e
+	}
+	current, e := os.ReadFile(filepath.Join(root, path))
+	if e != nil {
+		return e
+	}
+	if string(base) != string(current) {
+		return code("P05", "stale base for %s: %s changed since phase base", ids[0], path)
 	}
 	return nil
 }
+func codedCause(err error, ds []project.Diagnostic) error {
+	if err == nil || len(ds) == 0 || ds[0].Code == "" {
+		return err
+	}
+	if strings.HasPrefix(err.Error(), ds[0].Code+": ") {
+		return err
+	}
+	if ds[0].Code == "X01" && ds[0].Message != "" {
+		return code("X01", "%s: %v", ds[0].Message, err)
+	}
+	return code(ds[0].Code, "%v", err)
+}
