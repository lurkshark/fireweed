package lifecycle

import (
	"context"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"os"
	"path/filepath"
	"reflect"
	"regexp"
	"sort"
	"strings"
	"time"

	"github.com/lurkshark/fireweed/packages/assets"
	"github.com/lurkshark/fireweed/packages/checks"
	"github.com/lurkshark/fireweed/packages/contracts"
	"github.com/lurkshark/fireweed/packages/gitstore"
	"github.com/lurkshark/fireweed/packages/project"
	"github.com/lurkshark/fireweed/packages/workflow/model"
)

func approvedCheck(root string, ch project.Change, c claim) error {
	now, e := textFile(root, ch.Path)
	if e != nil {
		return e
	}
	a, e := contracts.ParseDocument(c.Approved)
	if e != nil {
		return e
	}
	b, e := contracts.ParseDocument(now)
	if e != nil {
		return e
	}
	for _, key := range []string{"run", "phase"} {
		if !reflect.DeepEqual(a.Frontmatter[key], b.Frontmatter[key]) {
			return code("P03", "approved run or phase changed")
		}
	}
	for _, key := range []string{"audit_rounds", "blocked"} {
		if !reflect.DeepEqual(a.Frontmatter[key], b.Frontmatter[key]) {
			return code("P03", "approved audit state changed")
		}
	}
	for _, key := range []string{"run", "phase", "audit_rounds", "blocked"} {
		delete(a.Frontmatter, key)
		delete(b.Frontmatter, key)
	}
	if !reflect.DeepEqual(a.Frontmatter, b.Frontmatter) {
		return code("P03", "approved author metadata changed")
	}
	if section(a.Body, "Provenance") != section(b.Body, "Provenance") {
		return code("P03", "approved run or phase changed")
	}
	if c.Phase != "audit" && section(a.Body, "Audit") != section(b.Body, "Audit") {
		return code("P03", "approved audit state changed")
	}
	for _, key := range []string{"Motivation", "Interface", "Added", "Modified", "Removed", "Removed decisions"} {
		if section(a.Body, key) != section(b.Body, key) {
			return code("P03", "approved author metadata changed")
		}
	}
	return nil
}
func phaseSpecBaseCheck(root string, ch project.Change, c claim) error {
	ids := append([]string{}, list(ch.Document.Frontmatter["fixes"])...)
	for _, it := range append(ch.Modified, ch.Removed...) {
		ids = append(ids, it.ID)
	}
	if len(ids) == 0 {
		return nil
	}
	m, ok := moduleFor(c.Snapshot, ch.Module)
	if !ok {
		return nil
	}
	path := filepath.ToSlash(filepath.Join(m.Dir, "SPEC.md"))
	base, e := gitstore.ReadAt(root, c.PhaseBase, path)
	if e != nil {
		return e
	}
	current, e := os.ReadFile(filepath.Join(root, path))
	if e != nil {
		return e
	}
	if string(base) != string(current) {
		return code("P05", "stale base for %s: %s changed since phase base", ids[0], path)
	}
	return nil
}
func codedCause(err error, ds []project.Diagnostic) error {
	if err == nil || len(ds) == 0 || ds[0].Code == "" {
		return err
	}
	if strings.HasPrefix(err.Error(), ds[0].Code+": ") {
		return err
	}
	return code(ds[0].Code, "%v", err)
}
func zoneCheck(root string, ch project.Change, c claim) error {
