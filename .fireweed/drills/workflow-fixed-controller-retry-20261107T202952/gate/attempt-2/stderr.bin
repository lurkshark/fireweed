)

type State struct {
	Change      project.Change
	Snapshot    project.Snapshot
	Run         string
	Phase       string
	Head        string
	PhaseBase   string
	ClaimOID    string
	Diagnostics []project.Diagnostic
}

type Request struct {
	Root    string
	Change  string
	Bin     string
	Agent   string
	Quick   bool
	Timeout time.Duration
}

type Result struct {
	State       State
	Reports     map[string]checks.Report
	Costs       []ModuleCost
	Diagnostics []project.Diagnostic
}

type ModuleCost struct {
	Module          string
	Seconds         float64
	CasesPerSpec    map[string]int
	EvalLines       int
	DisposableLines int
}

type CostSnapshot struct {
	Run         string
	Phase       string
	RecordedAt  time.Time
	Modules     []ModuleCost
	Diagnostics []project.Diagnostic
}

type StatusReport struct {
	Modules         []project.Module
	Queue           []StatusEntry
	Quarantines     []Quarantine
	BoundaryOptOuts []BoundaryOptOut
	DriftSinceDrill map[string]int
	Unapproved      int
	PhaseCommits    map[string]int
	Costs           []ModuleCost
	Diagnostics     []project.Diagnostic
}

type PRBodyReport struct {
	Body        string
	Diagnostics []project.Diagnostic
}

type StatusEntry struct {
	Slug        string
	Path        string
	Module      string
	Phase       string
	Blocked     string
	WaitingOn   string
	WaitingRule string
	AuditRounds int
}

type Quarantine struct {
	Module string
	ID     string
	Reason string
}

type BoundaryOptOut struct {
	Module string
	Reason string
}

type BlockRequest struct {
	Root   string
	Change string
	Reason string
}

type BlockResult struct {
	State      State
	AttemptRef string
	AttemptOID string
}

type GCRequest struct {
	Root string
	Now  time.Time
}

type GCResult struct {
	Pruned []string
}

