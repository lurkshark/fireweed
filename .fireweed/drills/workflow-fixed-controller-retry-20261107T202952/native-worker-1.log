+func Commits(root,selector string)([]string,error){r,e:=canonical(root);if e!=nil{return nil,e};ch,e:=selectChange(r,selector,true);if e!=nil{return nil,e};output,e:=git(r,"rev-list","HEAD");if e!=nil{return nil,e};out:=[]string{};name:=filepath.Base(ch.Path);for _,oid:=range strings.Fields(output){parent,_:=git(r,"rev-parse",oid+"^1");if parent==""{continue};a,b:=phaseAt(r,oid,name),phaseAt(r,parent,name);if a!=""&&a!=b{out=append(out,oid)}};return out,nil}
+func Abandon(root,selector string)(string,error){r,e:=canonical(root);if e!=nil{return "",e};ch,e:=selectChange(r,selector,true);if e!=nil{return "",e};isDirty,e:=dirty(r);if e!=nil{return "",e};if isDirty{return "",code("P01","abandon requires clean worktree")};if strings.Contains(ch.Path,"/archive/"){return "",code("P01","applied archived change cannot be abandoned")};_,oid,ok,e:=readClaim(r,ch);if e!=nil{return "",e};if ok{c,_,_,_:=readClaim(r,ch);if c.Worktree!=r{return "",code("P02","claim belongs to another worktree")}};commits,e:=Commits(r,ch.Path);if e!=nil{return "",e};for _,commit:=range commits{paths,_:=git(r,"diff-tree","--no-commit-id","--name-only","-r",commit);for _,path:=range strings.Split(paths,"\n"){if path==""||path==ch.Path||strings.HasPrefix(path,"changes/archive/"){continue};_,_ =git(r,"restore","--source="+commit+"^1","--staged","--worktree","--",path)}};if e=os.Remove(filepath.Join(r,ch.Path));e!=nil{return "",e};if _,e=git(r,"add","-A");e!=nil{return "",e};if _,e=git(r,"commit","-m","fireweed abandon "+ch.Slug);e!=nil{return "",e};if ok{_ =releaseClaim(r,ch,oid)};return git(r,"rev-parse","HEAD")}
+func Block(req model.BlockRequest)(model.BlockResult,error){var out model.BlockResult;r,e:=canonical(req.Root);if e!=nil{return out,e};ch,c,oid,e:=owned(r,req.Change);if e!=nil{return out,e};head,e:=git(r,"rev-parse","HEAD");if e!=nil{return out,e};if head!=c.PhaseBase{return out,code("P05","phase base changed")};if e=approvedCheck(r,ch,c);e!=nil{return out,e};n:=1;for{_,ok,e:=gitstore.Ref(r,"refs/fireweed/attempts/"+ch.Slug+"/"+strconv.Itoa(n));if e!=nil{return out,e};if !ok{break};n++};name:="refs/fireweed/attempts/"+ch.Slug+"/"+strconv.Itoa(n)
+ if _,e=git(r,"add","-A");e!=nil{return out,e};tree,e:=git(r,"write-tree");if e!=nil{return out,e};attempt,e:=git(r,"commit-tree",tree,"-p",head,"-m","fireweed attempt "+ch.Slug);if e!=nil{return out,e};if e=gitstore.CASRef(r,name,"",attempt);e!=nil{return out,e};out.AttemptRef=name;out.AttemptOID=attempt
+ if _,e=git(r,"reset","--hard",head);e!=nil{return out,e};_,_ =git(r,"clean","-fd")
+ doc,e:=contracts.ParseDocument(c.Approved);if e!=nil{return out,e};doc.Frontmatter["blocked"]=req.Reason;s,e:=render(doc);if e!=nil{return out,e};if e=writeFile(r,ch.Path,s);e!=nil{return out,e};if _,e=git(r,"add","--",ch.Path);e!=nil{return out,e};if _,e=git(r,"commit","-m","fireweed block "+ch.Slug);e!=nil{return out,e};_ =releaseClaim(r,ch,oid);head,e=git(r,"rev-parse","HEAD");if e!=nil{return out,e};c.PhaseBase=head;out.State,e=state(r,ch,c,"");if e!=nil{return out,e};out.State.Change.Document=doc;return out,nil}
+func GC(ctx context.Context,req model.GCRequest)(model.GCResult,error){_ =ctx;out:=model.GCResult{Pruned:[]string{}};r,e:=canonical(req.Root);if e!=nil{return out,e};snap,e:=project.Load(r);if e!=nil{return out,e};max:=720*time.Hour;if raw:=frontString(nested(snap.Config,"gc")["drill_max_age"]);raw!=""{max,e=time.ParseDuration(raw);if e!=nil||max<=0{return out,code("C01","invalid gc.drill_max_age %q",raw)}};now:=req.Now;if now.IsZero(){now=time.Now().UTC()};refs,e:=git(r,"for-each-ref","--format=%(refname) %(objectname)","refs/fireweed");if e!=nil{return out,e};registered,_:=git(r,"worktree","list","--porcelain");worktrees:=map[string]bool{};for _,line:=range strings.Split(registered,"\n"){if strings.HasPrefix(line,"worktree "){p,_:=filepath.EvalSymlinks(strings.TrimPrefix(line,"worktree "));worktrees[p]=true}};for _,line:=range strings.Split(refs,"\n"){parts:=strings.Fields(line);if len(parts)!=2{continue};name,oid:=parts[0],parts[1];remove:=false
