+func Eligible(root string) ([]project.Change, error) {
+	r, e := canonical(root)
+	if e != nil {
+		return nil, e
+	}
+	q, e := project.Queue(r)
+	if e != nil {
+		return nil, e
+	}
+	out := []project.Change{}
+	for i, ch := range q {
+		if frontString(ch.Document.Frontmatter["blocked"]) != "" {
+			continue
+		}
+		on, _ := waiting(r, q, i)
+		if on == "" {
+			out = append(out, ch)
+		}
+	}
+	return out, nil
