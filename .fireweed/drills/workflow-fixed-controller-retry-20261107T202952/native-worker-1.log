+ head,e:=git(r,"rev-parse","HEAD");if e!=nil{return model.State{},e};original,e:=textFile(r,ch.Path);if e!=nil{return model.State{},e};s:=original
+ doc,e:=contracts.ParseDocument(s);if e!=nil{return model.State{},e};if resume&&frontString(doc.Frontmatter["phase"])==""{return model.State{},code("P01","attempt requires committed phase")}
+ if !resume{if e=validateBases(r,ch);e!=nil{return model.State{},e};s,e=assignIDs(r,ch,s);if e!=nil{return model.State{},e};doc,e=contracts.ParseDocument(s);if e!=nil{return model.State{},e}}
+ phase:=frontString(doc.Frontmatter["phase"]);run:=frontString(doc.Frontmatter["run"])
+ if phase==""{phase="evals";if len(ch.Added)+len(ch.Modified)+len(ch.Removed)==0&&len(list(doc.Frontmatter["fixes"]))==0&&len(list(doc.Frontmatter["eval_fix"]))==0{phase="impl"};if frontBool(doc.Frontmatter["regenerate"]){phase="impl"}}
+ if run==""{run=runID()};doc.Frontmatter["phase"]=phase;doc.Frontmatter["run"]=run;s,e=render(doc);if e!=nil{return model.State{},e}
