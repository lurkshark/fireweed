+func assignIDs(root string,ch project.Change,s string)(string,error){doc,e:=contracts.ParseDocument(s);if e!=nil{return s,e};items,e:=contracts.ParseItems(section(doc.Body,"Added"));if e!=nil{return s,e};if len(items)==0{return s,nil};snap,e:=project.Load(root);if e!=nil{return s,e};prefix:="";used:=map[int]bool{};for _,m:=range snap.Modules{if m.Name!=ch.Module{continue};prefix=m.IDPrefix;for _,it:=range mustItems(section(m.Document.Body,"Specs")){var n int;if _,e:=fmt.Sscanf(it.ID,prefix+"-%d",&n);e==nil{used[n]=true}}};q,_:=project.Queue(root);for _,other:=range q{for _,it:=range other.Added{var n int;if _,e:=fmt.Sscanf(it.ID,prefix+"-%d",&n);e==nil{used[n]=true}}};for _,it:=range items{if !strings.HasPrefix(it.ID,"new:"){continue};n:=1;for used[n]{n++};used[n]=true;s=strings.ReplaceAll(s,it.ID,fmt.Sprintf("%s-%03d",prefix,n))};return s,nil}
+func section(body,name string)string{s,_:=contracts.Section(body,name);return s}
+func mustItems(s string)[]contracts.Item{it,_:=contracts.ParseItems(s);return it}
+func deleteDisposable(root string,ch project.Change,snap project.Snapshot)error{for _,m:=range snap.Modules{if m.Name!=ch.Module{continue};return filepath.WalkDir(filepath.Join(root,m.Dir),func(p string,d os.DirEntry,e error)error{if e!=nil{return nil};if d.IsDir(){return nil};rel,_:=filepath.Rel(filepath.Join(root,m.Dir),p);if contracts.ResolveZone(filepath.ToSlash(rel),m.Zones)=="disposable"{return os.Remove(p)};return nil})};return nil}
+func restoreAttempt(root string,ch project.Change,n int,approved string)error{ref:="refs/fireweed/attempts/"+ch.Slug+"/"+strconv.Itoa(n);files,e:=git(root,"diff","--name-only","HEAD",ref);if e!=nil{return e};for _,path:=range strings.Split(files,"\n"){if path==""{continue};if path==ch.Path{old,e:=gitstore.ReadAt(root,ref,path);if e!=nil{continue};d,e:=contracts.ParseDocument(string(old));if e!=nil{continue};cur,_:=contracts.ParseDocument(approved);if s,ok:=contracts.Section(d.Body,"Audit");ok{cur.Body=contracts.ReplaceSection(cur.Body,"Audit",s)};text,e:=render(cur);if e==nil{_ =writeFile(root,path,text)};continue};b,e:=gitstore.ReadAt(root,ref,path);if e!=nil{_ =os.Remove(filepath.Join(root,path));continue};_ =writeFile(root,path,string(b))};return nil}
